ens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2020-12-14T20:23:24.000Z"}, "classification": {"categories": ["infrastructure", "public safety"], "tags": [], "domain_category": "Fire and Rescue Response", "domain_tags": ["fire truck", "calls", "response time", "incidents", "motor vehicle collisions", "ambulance"], "domain_metadata": [{"key": "Department_Group", "value": "City Services"}, {"key": "Department_Department", "value": "Fire Paramedic Service"}, {"key": "Quality_Rank", "value": "Gold"}, {"key": "Update-Frequency_Interval", "value": "Real-time"}, {"key": "Licence_Licence", "value": "Open Government Licence - Winnipeg"}]}, "metadata": {"domain": "data.winnipeg.ca", "license": "Canada Open Government Licence"}, "permalink": "https://data.winnipeg.ca/d/yg42-q284", "link": "https://data.winnipeg.ca/Fire-and-Rescue-Response/WFPS-Call-Logs/yg42-q284", "owner": {"id": "9x28-xwwt", "user_type": "interactive", "display_name": "Open Data Services"}, "creator": {"id": "9x28-xwwt", "user_type": "interactive", "display_name": "Open Data Services"}}
