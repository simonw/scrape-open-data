{"resource": {"name": "WFPS Call Logs", "id": "yg42-q284", "parent_fxf": [], "description": "The data set will list every call the WFPS has responded to between 2015 to present, which units responded, whether it was a medical emergency or fire/rescue call, when the incident resolved, whether it involved a vehicular collision, and which neighbourhood and electoral ward it took place in.  The data is based on the calls received, which may not necessitate a unit being sent as additional information is provided.  \n\nThe units can be broken down as follows: \n\nMedical -\nDC: District Chief \nEPIC: Emergency Paramedics in the Community Unit\nMIRV: Major Incident Response Unit\nPACE: Non Motorized Unit\nPTRS: Special Assignment Unit \n##: Ambulance Unit\n\nFire Rescue -\nATV: Special Rescue\nBN: Special Rescue\nCV: Special Rescue\nD: District Chief\nDCT: Special Rescue\nE: Engine/Pumper\nFI: Fire Investigator\nGA: Gator\nGEN: Special Rescue\nHM: Hazmat\nL: Ladder\nP: Platoon Chief\nR: Rescue\nRU: Special Rescue\nS: Platoon Safety Officer\nSN: Special Rescue\nSQ: Squad\nT: Special Rescue\nTC: Special Rescue\nW: Water Rescue\nWERU: Special Rescue\nWL: Special Rescue", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-08-08T14:28:21.000Z", "createdAt": "2020-12-14T19:33:20.000Z", "metadata_updated_at": "2024-08-08T14:28:15.000Z", "data_updated_at": "2024-08-08T14:28:21.000Z", "columns_name": ["Incident Number", "Incident Type", "Call Time", "Closed Time", "Motor Vehicle Incident", "Units", "Neighbourhood", "Ward"], "columns_field_name": ["incident_number", "incident_type", "call_time", "closed_time", "motor_vehicle_incident", "units", "neighbourhood", "ward"], "columns_datatype": ["Number", "Text", "Calendar date", "Calendar date", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", ""], "columns_format": [{"noCommas": "true"}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2020-12-14T20:23:24.000Z"}, "classification": {"categories": ["infrastructure", "public safety"], "tags": [], "domain_category": "Fire and Rescue Response", "domain_tags": ["fire truck", "calls", "response time", "incidents", "motor vehicle collisions", "ambulance"], "domain_metadata": [{"key": "Department_Group", "value": "City Services"}, {"key": "Department_Department", "value": "Fire Paramedic Service"}, {"key": "Quality_Rank", "value": "Gold"}, {"key": "Update-Frequency_Interval", "value": "Real-time"}, {"key": "Licence_Licence", "value": "Open Government Licence - Winnipeg"}]}, "metadata": {"domain": "data.winnipeg.ca", "license": "Canada Open Government Licence"}, "permalink": "https://data.winnipeg.ca/d/yg42-q284", "link": "https://data.winnipeg.ca/Fire-and-Rescue-Response/WFPS-Call-Logs/yg42-q284", "owner": {"id": "9x28-xwwt", "user_type": "interactive", "display_name": "Open Data Services"}, "creator": {"id": "9x28-xwwt", "user_type": "interactive", "display_name": "Open Data Services"}}
