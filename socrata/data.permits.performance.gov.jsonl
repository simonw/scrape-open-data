{"resource": {"name": "FAA Categorical Exclusions", "id": "mmij-mm9x", "parent_fxf": [], "description": "The Department of Transportation is expanding functionality on the Permitting Dashboard by providing information on Operating Administration projects advanced through Categorical Exclusions (CEs). Providing this further transparency into the decision-making process will allow stakeholders to better understand which projects already qualify for CEs, and provide practitioners with analysis that can be used to inform future environmental review processes.\n\nThe Federal Aviation Administration (FAA) information includes where available, Project Name, Location, Funding Program, CE applied, NEPA start date and completion date.", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-06-10T20:26:55.000Z", "createdAt": "2024-06-05T18:09:51.000Z", "metadata_updated_at": "2024-06-10T20:26:55.000Z", "data_updated_at": "2024-06-10T20:25:27.000Z", "columns_name": ["CE Start Date", "CE Completion Date (Determination Date)", "Project Name", "State", "Funding Program", "CE Applied"], "columns_field_name": ["ce_start_date", "ce_completion_date", "project_name", "state", "funding_program", "ce_applied"], "columns_datatype": ["Calendar date", "Calendar date", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", ""], "columns_format": [{"view": "date"}, {"view": "date"}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2024-06-10T20:25:33.000Z"}, "classification": {"categories": [], "tags": [], "domain_tags": [], "domain_metadata": []}, "metadata": {"domain": "data.permits.performance.gov"}, "permalink": "https://data.permits.performance.gov/d/mmij-mm9x", "link": "https://data.permits.performance.gov/dataset/FAA-Categorical-Exclusions/mmij-mm9x", "owner": {"id": "