{"resource": {"name": "San Jacinto Daily Rainfall - Station 186", "id": "irhj-j2uf", "resource_name": null, "parent_fxf": [], "description": "Daily Rainfall for Station 186 in San Jacinto from 2/1/1940 to 12/31/15. Daily Rainfall is collected by a volunteer observer who reads the gauge everyday at the same time (8AM). In more recent years the data at important record sites is collected by automatic rain gauges. This data is collected to help analyze rainfall totals in specific areas. This supports RCFC's efforts to build adequate facilities which protect the residents of Riverside County.", "attribution": "Robert Laag", "attribution_link": "http://rcflood.org/RainFallMap.aspx", "contact_email": null, "type": "dataset", "updatedAt": "2016-10-12T16:22:26.000Z", "createdAt": "2016-07-13T16:11:33.000Z", "metadata_updated_at": "2016-10-12T16:22:26.000Z", "data_updated_at": "2016-07-13T16:16:21.000Z", "columns_name": ["Location 1", "Rainfall amount (inches)", "Date", "Location 1 (address)", "Location 1 (zip)", "Location 1 (city)", "Location 1 (state)", "Station"], "columns_field_name": ["location_1", "rainfall_amount_inches", "date", "location_1_address", "location_1_zip", "location_1_city", "location_1_state", "station"], "columns_datatype": ["Point", "Number", "Calendar date", "Text", "Text", "Text", "Text", "Number"], "columns_description": ["", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2016-07-13T16:18:20.000Z"}, "classification": {"categories": ["housing & development", "infrastructure"], "tags": [], "domain_category": "Land Use and Environment", "domain_tags": ["daily rain", "precipitation", "rainfall", "rain gauge"], "domain_metadata": [{"key": "Data-Information_Agencies-and-Departments", "value": "Flood Control"}]}, "metadata": {"domain": "data.countyo