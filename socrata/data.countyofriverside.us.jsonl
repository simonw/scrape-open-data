{"resource": {"name": "Behavioral Health", "id": "mv29-2hwv", "resource_name": null, "parent_fxf": [], "description": "This data is recorded in the Riverside University Health Systems-BH  electronic health record. The report is an aggregated summary of the unduplicated clients served by RUHS-BH in a Fiscal Year.  The data set is a de-indentified extraction of the unduplicated clients served in a Fiscal Year and includes the characteristics of the population including: age; Race/Ethnicity, Gender, Geographic Region of County (Desert, Western, Mid-County); Education (18-59yr olds); Martial Status; and Primary Diagnosis.", "attribution": "Ryan Quist", "attribution_link": "http://www.rcdmh.org", "contact_email": null, "type": "dataset", "updatedAt": "2017-06-01T14:50:54.000Z", "createdAt": "2016-11-14T18:17:55.000Z", "metadata_updated_at": "2017-06-01T14:50:54.000Z", "data_updated_at": "2016-11-14T18:18:17.000Z", "columns_name": ["Age", "History of Experiencing Trauma", "Race/Ethnicity", "Most recent Primary Diagnosis", "Geographic Service Region", "Random Id", "Medi-Cal Eligible", "Gender", "History of Mental Illness", "Mental Health or Substance Abuse", "Transition Age Youth", "Fiscal Year", "History of Substance Use"], "columns_field_name": ["age", "history_of_experiencing_trauma", "race_ethnicity", "most_recent_primary_diagnosis", "geographic_service_region", "random_id", "medi_cal_eligible", "gender", "history_of_mental_illness", "mental_health_or_substance_abuse", "transition_age_youth", "fiscal_year", "history_of_substance_use"], "columns_datatype": ["Text", "Checkbox", "Text", "Text", "Text", "Number", "Checkbox", "Text", "Checkbox", "Number", "Number", "Number", "Checkbox"], "columns_description": ["\"Age as of the end of the FY. Category Values: <18, 18-59 yrs, 60+yrs\n\"\n", "Only collected for MH consumers\n", "Category Values: Caucasian, Black/African American, Latino, Asian/Pacific Islander, Native American, Other/Unknown.\n", "\"Category Values: AD/D, Organic, Drug and Alcohol, Schizophrenia/Psychosis, MoodAnxAdjustment, Major Depression, Bi-Polar, Other MH Diagnosis, Amphetamines, Cannabis, Cocaine, Inhalants, Hallucinogen, Opined, Other SA Diagnosis\n\"\n", "Category Values: Western, Mid-County, Desert\n", "Random, deidentified ID assigned to replace RUHS-BH client ID\n", "Consumer had Medi-Cal eligibility at least once in the fiscal year.\n", "Category variables: Male, Female, Unknown\n", "Only collected for SA consumers\n", "1=MH (Mental Health); 2=SA (Substance Abuse)\n", "Sub-population of major age groups, true or false if they belong to the transition age group 16-25 years of age.\n", "Value will be based on year FY ended. For example FY 15/16 will have a 16.\n", "For MH Consumers only: History of Service in Substance Use Department or Substance use co-occurring diagnosis. \n"], "columns_format": [{"displayStyle": "plain", "align": "left"}, {"align": "center"}, {"displayStyle": "plain", "align": "left"}, {"displayStyle": "plain", "align": "left"}, {"displayStyle": "plain", "align": "left"}, {"precisionStyle": "standard", "noCommas": "false", "align": "right"}, {"align": "center"}, {"displayStyle": "plain", "align": "left"}, {"align": "center"}, {"precisionStyle": "standard", "noCommas": "false", "align": "right"}, {"precisionStyle": "standard", "noCommas": "false", "align": "right"}, {"precisionStyle": "standard", "noCommas": "true", "align": "right"}, {"align": "center"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2016-11-14T18:26:53.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Health and Social Services", "domain_tags": ["behavioral health", "clients served", "mental health", "substance abuse", "total clients", "total served", "who we serve"], "domain_metadata": [{"key": "Data-Information_Agencies-and-Departments", "value": "Behavioral Health