{"resource": {"name": "Behavioral Health", "id": "mv29-2hwv", "parent_fxf": [], "description": "This data is recorded in the Riverside University Health Systems-BH  electronic health record. The report is an aggregated summary of the unduplicated clients served by RUHS-BH in a Fiscal Year.  The data set is a de-indentified extraction of the unduplicated clients served in a Fiscal Year and includes the characteristics of the population including: age; Race/Ethnicity, Gender, Geographic Region of County (Desert, Western, Mid-County); Education (18-59yr olds); Martial Status; and Primary Diagnosis.", "attribution": "Ryan Quist", "attribution_link": "http://www.rcdmh.org", "contact_email": null, "type": "dataset", "updatedAt": "2017-06-01T14:50:54.000Z", "createdAt": "2016-11-14T18:17:55.000Z", "metadata_updated_at": "2017-06-01T14:50:54.000Z", "data_updated_at": "2016-11-14T18:18:17.000Z", "columns_name": ["Random Id", "Age", "History of Experiencing Trauma", "Fiscal Year", "Transition Age Youth", "Mental Health or Substance Abuse", "History of Mental Illness", "Gender", "Medi-Cal Eligible", "Race/Ethnicity", "Geographic Service Region", "Most recent Primary Diagnosis", "History of Substance Use"], "columns_field_name": ["random_id", "age", "history_of_experiencing_trauma", "fiscal_year", "transition_age_youth", "mental_health_or_substance_abuse", "history_of_mental_illness", "gender", "medi_cal_eligible", "race_ethnicity", "geographic_service_region", "most_recent_primary_diagnosis", "history_of_substance_use"], "columns_datatype": ["Number", "Text", "Checkbox", "Number", "Number", "Number", "Checkbox", "Text", "Checkbox", "Text", "Text", "Text", "Checkbox"], "columns_description": ["Random, deidentified ID assigned to replace RUHS-BH client ID\n", "\"Age as of the end of the FY. Category Values: <18, 18-59 yrs, 60+yrs\n\"\n", "Only collected for MH consumers\n", "Value will be based on year FY ended. For example FY 15/16 will have a 16.\n", "Sub-population of major age groups, true or false if they belong to the transition age group 16-25 years of age.\n", "1=MH (Mental Health); 2=SA (Substance Abuse)\n", "Only collected for SA consumers\n", "Category variables: Male, Female, Unknown\n", "Consumer had Medi-Cal eligibility at least once in the fiscal year.\n", "Category Values: Caucasian, Black/African American, Latino, Asian/Pacific Islander, Native American, Other/Unknown.\n", "Category Values: Western, Mid-County, Desert\n", "\"Category Values: AD/D, Organic, Drug and Alcohol, Schizophrenia/Psychosis, MoodAnxAdjustment, Major Depression, Bi-Polar, Other MH Diagnosis, Amphetamines, Cannabis, Cocaine, Inhalants, Hallucinogen, Opined, Other SA Diagnosis\n\"\n", "For MH Consumers only: History of Service in Substance Use Department or Substance use co-occurring diagnosis. \n"], "columns_format": [{"precisionStyle": "standard", "noCommas": "false", "align": "right"}, {"displayStyle": "plain", "align": "left"}, {"align": "center"}, {"precisionStyle": "standard", "noCommas": "true", "align": "right"}, {"precisionStyle": "standard", "noCommas": "false", "align": "right"}, {"precisionStyle": "standard", "noCommas": "false", "align": "right"}, {"align": "center"}, {"displayStyle": "plain", "align": "left"}, {"align": "center"}, {"displayStyle": "plain", "align": "left"}, {"displayStyle": "plain", "align": "left"}, {"displayStyle": "plain", "align": "left"}, {"align": "center"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2016-11-14T18:26:53.000Z"}, "classification": {"categories": ["demographics", "finance"], "tags": [], "domain_category": "Health and Social Services", "domain_tags": ["behavioral health", "clients served", "mental health", "substance abuse", "total clients", "total served", "who we serve"], "domain_metadata": [{"key": "Data-Information_Agencies-and-Departments", "value": "Behavioral Heal