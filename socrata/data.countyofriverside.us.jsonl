{"resource": {"name": "Animal Services - Disposition Report", "id": "yp5r-45sf", "parent_fxf": [], "description": "The information is extracted from the \"animal\" database through chameleon (shelter application).  In accordance with Food & Agriculture Code 32003,  all public pounds and shelters shall keep accurate records on each animal impounded that includes the final disposition of the animal.  This information is to show disposition trends for each shelter and jurisdiction.", "attribution": "Irene Anderson", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-12-12T15:09:53.000Z", "createdAt": "2019-09-11T19:17:05.000Z", "metadata_updated_at": "2022-12-12T15:09:51.000Z", "data_updated_at": "2022-12-12T15:09:53.000Z", "columns_name": ["Other Id", "Animal Id", "Disposition Date", "Type of Impound", "Shelter Location", "Jurisdiction", "Impound Date", "Animal Type", "Impound No", "Disposition Type"], "columns_field_name": ["other_id", "animal_id", "disposition_date", "type_of_impound", "shelter_location", "jurisdiction", "impound_date", "animal_type", "impound_no", "disposition_type"], "columns_datatype": ["Text", "Text", "Calendar date", "Text", "Text", "Text", "Calendar date", "Text", "Text", "Text"], "columns_description": ["refers to a secondary identification of the impounded animal\n", "unique number automatically assigned by chameleon specific to the animal information\n", "refers to the disposition date of the animal\n", "defines the reason why an animal was impounded, i.e., stray, owner surrender, euth request\n", "", "Jurisdiction the animal was impounded from", "refers to the date the animal was impounded\n", "type of animal impounded", "unique number automatically assigned by chameleon that is specific to the record\n", "defines the reason for an impounded animal's outcome\n"], "columns_format": [{"displayStyle": "plain", "align": "center"}, {"displayStyle": "plain", "align": "center"}, {"view": "date", "align": "cente