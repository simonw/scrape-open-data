{"resource": {"name": "Covid-19 | Cases", "id": "jhy9-25m3", "parent_fxf": [], "description": "March 2020 - Present. An overview by locality of total cases, total hospitalizations and total deaths for the Commonwealth of Virginia. Updated daily at 12:00 p.m.\n\nFrom data.virginia.gov: \"This data set includes the cumulative (total) number of COVID-19 cases, hospitalizations, and deaths for each locality in Virginia by report date. This data set was first published on April 01, 2020. The data set increases in size daily and as a result, the dataset may take longer to update; however, it is expected to be available by 12:00 noon daily. When you download the data set, the dates will be sorted in ascending order, meaning that the earliest date will be at the top. To see data for the most recent date, please scroll down to the bottom of the data set. The Virginia Department of Health\u2019s Thomas Jefferson Health District (TJHD) will be renamed to Blue Ridge Health District (BRHD), effective January 2021. More information about this change can be found here: https://www.vdh.virginia.gov/blue-ridge/name-change/\"", "attribution": "Virginia Department of Health", "attribution_link": "https://data.virginia.gov/Government/VDH-COVID-19-PublicUseDataset-Cases/bre9-aqqr", "contact_email": null, "type": "dataset", "updatedAt": "2022-10-03T09:00:38.000Z", "createdAt": "2021-06-03T23:40:33.000Z", "metadata_updated_at": "2022-10-03T09:00:10.000Z", "data_updated_at": "2022-10-03T09:00:38.000Z", "columns_name": ["locality", "hospitalizations", "total_cases", "report_date", "fips", "vdh_health_district", "deaths"], "columns_field_name": ["locality", "hospitalizations", "total_cases", "report_date", "fips", "vdh_health_district", "deaths"], "columns_datatype": ["Text", "Number", "Number", "Calendar date", "Number", "Text", "Number"], "columns_description": ["Independent city or county in Virginia", "Total number of COVID-19 hospitalizations", "Total number of COVID-19 cases", "Date when the case, hospitalization, or death is published", "5-digit code (51XXX) for the locality", "Health district name assigned by the Virginia Department of Health. There are 35 health districts in Virginia.", "Total number of COVID-19 deaths"], "columns_format": [{}, {}, {}, {"view": "date"}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2021-06-03T23:45:40.000Z"}, "classification": {"categories": ["health", "public safety"], "tags": [], "domain_category": "Health", "domain_tags": ["cases", "covid-19", "deaths", "health district", "hospitalizations", "locality", "vdh", "virginia"], "domain_metadata": []}, "metadata": {"domain": "data.dumfriesva.gov", "license": "Public Domain"}, "permalink": "https://data.dumfriesva.gov/d/jhy9-25m3", "link": "https://data.dumfriesva.gov/Health/Covid-19-Cases/jhy9-25m3", "owner": {"id": "wuz3-gx9s", "user_type": "interactive", "display_name": "lharos"}, "creator": {"id": "wuz3-gx9s", "user_type": "interactive", "display_name": "lharos"}}
