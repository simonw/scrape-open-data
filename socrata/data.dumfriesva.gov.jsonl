{"resource": {"name": "Covid-19 | Vaccine Doses Administered", "id": "ycjg-fh3q", "parent_fxf": [], "description": "December 2020 - Present. Vaccine doses administered daily in the Commonwealth of Virginia. Updated daily from data.virginia.gov at 12:00 p.m.\n\nFrom data.virginia.gov: \"This dataset includes the number of COVID-19 vaccine doses administered for each locality in Virginia by administration date and by facility type. The data set increases in size daily and as a result, the dataset may take longer to update; however, it is expected to be available by 12:00 noon daily.\"", "attribution": "Virginia Department of Health", "attribution_link": "https://www.vdh.virginia.gov/", "contact_email": null, "type": "dataset", "updatedAt": "2022-09-05T16:04:01.000Z", "createdAt": "2021-06-02T21:29:02.000Z", "metadata_updated_at": "2022-09-05T16:03:01.000Z", "data_updated_at": "2022-09-05T16:04:01.000Z", "columns_name": ["locality", "health_district", "vaccine_doses_administered", "administration_date", "vaccine_manufacturer", "dose_number", "facility_type", "fips"], "columns_field_name": ["locality", "health_district", "vaccine_doses_administered", "administration_date", "vaccine_manufacturer", "dose_number", "facility_type", "fips"], "columns_datatype": ["Text", "Text", "Number", "Calendar date", "Text", "Number", "Text", "Text"], "columns_description": ["Independent city or county in Virginia where the person lives who was administered the vaccine.", "Health district name assigned by the Virginia Department of Health. There are 35 health districts in Virginia.", "Total number of vaccine doses administered.", "Date when the vaccine dose is administered to a person.", "Name of the manufacturing company that produced the vaccine.", "Dose number for the person who is administered the vaccine.", "Facility type of the provider that performed the vaccine administration.", "5-digit code (51XXX) for the locality"], "columns_format": [{}, {}, {}, {"view": "date"}, {}, {}, {},