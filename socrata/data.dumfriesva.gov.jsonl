{"resource": {"name": "Covid-19 | Vaccine Doses Administered", "id": "ycjg-fh3q", "parent_fxf": [], "description": "December 2020 - Present. Vaccine doses administered daily in the Commonwealth of Virginia. Updated daily from data.virginia.gov at 12:00 p.m.\n\nFrom data.virginia.gov: \"This dataset includes the number of COVID-19 vaccine doses administered for each locality in Virginia by administration date and by facility type. The data set increases in size daily and as a result, the dataset may take longer to update; however, it is expected to be available by 12:00 noon daily.\"", "attribution": "Virginia Department of Health", "attribution_link": "https://www.vdh.virginia.gov/", "contact_email": null, "type": "dataset", "updatedAt": "2022-09-06T16:05:06.000Z", "createdAt": "2021-06-02T21:29:02.000Z", "metadata_updated_at": "2022-09-06T16:03:36.000Z", "data_updated_at": "2022-09-06T16:05:06.000Z", "columns_name": ["administration_date", "vaccine_manufacturer", "fips", "dose_number", "facility_type", "vaccine_doses_administered", "health_district", "locality"], "columns_field_name": ["administration_date", "vaccine_manufacturer", "fips", "dose_number", "facility_type", "vaccine_doses_administered", "health_district", "locality"], "columns_datatype": ["Calendar date", "Text", "Text", "Number", "Text", "Number", "Text", "Text"], "columns_description": ["Date when the vaccine dose is administered to a person.", "Name of the manufacturing company that produced the vaccine.", "5-digit code (51XXX) for the locality", "Dose number for the person who is administered the vaccine.", "Facility type of the provider that performed the vaccine administration.", "Total number of vaccine doses administered.", "Health district name assigned by the Virginia Department of Health. There are 35 health districts in Virginia.", "Independent city or county in Virginia where the person lives who was administered the vaccine."], "columns_format": [{"view": "date"}, {}, {}, {}, {}, {}, {},