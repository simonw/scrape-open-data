{"resource": {"name": "CBRM_Buildings", "id": "sb2f-wrrc", "resource_name": null, "parent_fxf": [], "description": "The dataset contains the building footprints of all buildings in the CBRM as polygons. Along with the spatial information, the dataset also includes specific attributes of the buildings such as building description, class, and building name.\r\nAttribute descriptions:\r\nTHE_GEOM: Building polygon geometry\r\nCODE1: Identifies the building uses\r\nCODE2: Identifies the building uses if more than 1\r\nCODE3: Identifies the building uses if more than 2\r\nCODE4: Identifies the building uses if more than 3\r\nCODE5: Identifies the building uses if more than 4\r\nCODE6: Identifies the building uses if more than 5\r\nCODE7: Identifies the building uses if more than 6\r\nCODE8: Identifies the building uses if more than 7\r\nCODE9: Identifies the building uses if more than 8\r\nCODE10: Identifies the building uses if more than 9\r\nDESCRIP1: Description of building\r\nDESCRIP2: Description of building if more than 1\r\nDESCRIP3: Description of building if more than 2\r\nNAME: Name of building if exists\r\nGEN_CLASS: General class of building\r\nGEN_CLASS2: Secondary general class of building\r\nDB_UPDATED: Last date the attributes were updated\r\nGR_UPDATED: Last date the geometry was updated", "attribution": "Cape Breton Regional Municipality (CBRM)", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-04-10T19:56:42.000Z", "createdAt": "2016-12-12T16:17:48.000Z", "metadata_updated_at": "2024-04-10T19:56:42.000Z", "data_updated_at": "2017-04-25T15:37:28.000Z", "columns_name": ["CODE10", "GR_UPDATED", "GEN_CLASS2", "NAME", "DESCRIP3", "DESCRIP2", "DESCRIP1", "CODE5", "CODE4", "CODE3", "the_geom", "CODE1", "CODE6", "DB_UPDATED", "CODE7", "CODE2", "CODE9", "GEN_CLASS", "CODE8"], "columns_field_name": ["code10", "gr_updated", "gen_class2", "name", "descrip3", "descrip2", "descrip1", "code5", "code4", "code3", "the_geom", "code1", "code6", "db_updated", "code7", "code2", "code9", "gen_class", "code8"], "columns_datatype": ["Text", "Date", "Text", "Text", "Text", "Text", "Text", "Text", "Text", "Text", "MultiPolygon", "Text", "Text", "Date", "Text", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2017-04-25T15:37:29.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Mapping", "domain_tags": ["building class", "building footprint", "buildings", "cape breton regional municipality", "cbrm", "gis", "mapping"], "domain_metadata": [{"key": "License/Attribution_License-URL", "value": "https://www.pvsc.ca/en/home/datazone/datazone-license.aspx"}, {"key": "License/Attribution_License-Name", "value": "Open Data & Information Government Licence \u2013 PVSC & Participating Municipalities"}, {"key": "License/Attribution_Data-Provider", "value": "Cape Breton Regional Municipality (CBRM)"}, {"key": "Municipal-Information_Municipality-Name", "value": "Cape Breton Regional Municipality (CBRM)"}]}, "metadata": {"domain": "www.thedatazone.ca"}, "permalink": "https://www.thedatazone.ca/d/sb2f-wrrc", "link": "https://www.thedatazone.ca/Mapping/CBRM_Buildings/sb2f-wrrc", "owner": {"id": "db6v-i4s3", "user_type": "interactive", "display_name": "datazONE"}, "creator": {"id": "db6v-i4s3", "user_type": "interactive", "display_name": "datazONE"}}
