{"resource": {"name": "Business Services - Faulty Utility Meters", "id": "ygkp-e8sz", "parent_fxf": [], "description": "This dataset contains the number of faulty meters (gas, water, electric) that are detected each month and how many of those meters had been faulty for 3 months or less. A faulty meter is one that is not registering the usage correctly.", "attribution": "Business Services", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-08-01T14:50:04.000Z", "createdAt": "2020-04-01T20:36:02.000Z", "metadata_updated_at": "2022-05-17T21:35:11.000Z", "data_updated_at": "2022-08-01T14:50:04.000Z", "columns_name": ["Fiscal Year", "Fiscal Year Date", "Calendar Year", "Percent Faulty Meters Found in 3 Months or Less", "Average Months Backbilled", "Faulty Meters Found in 3 Months or Less", "Row ID", "Month", "Faulty Meters Found", "Month Date"], "columns_field_name": ["fiscal_year", "fiscal_year_date", "calendar_year", "percent_faulty_meters_found_in_3_months_or_less", "average_months_backbilled", "faulty_meters_found_in_3", "row_id", "month", "faulty_meters_found", "month_date"], "columns_datatype": ["Text", "Calendar date", "Text", "Number", "Number", "Number", "Text", "Text", "Number", "Calendar date"], "columns_description": ["Fiscal year the faulty meter was found. ", "Fiscal year represented by January 1 for the given year ", "Calendar year the faulty meter was found. ", "The number of faulter meters found in 3 months or less/the number of faulty meters found. ", "The total number of months back billed / the number of meters back billed, rounded to the whole number since billing is monthly. The total number of months back billed / the number of meters back billed, rounded to the whole number since billing is monthly. ", "Of the meters found that were not registering correctly, the number that had been faulty for 3 months or less. ", "Unique Row identifier ", "Month name only ", "The numbers of meters found that were not registering usage correctly. ", "Converting the Month name to a date format using the 1st day of the month and the current calendar year. (ex. June = 06/01/2020) "], "columns_format": [{}, {"view": "date"}, {}, {"precisionStyle": "percentage", "percentScale": "1", "precision": "2"}, {}, {}, {}, {}, {}, {"view": "date"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2020-04-01T20:51:34.000Z"}, "classification": {"categories": ["finance"], "tags": [], "domain_category": "Business Services", "domain_tags": ["back billing", "faulty meters"], "domain_metadata": [{"key": "Public-Access_Public-Access-Level", "value": "Public"}, {"key": "Terms-of-Use_Terms-of-Use", "value": "https://data.mesaaz.gov/stories/s/2dcd-j2nx/"}, {"key": "Frequency_Publishing", "value": "Monthly"}, {"key": "Frequency_Data-Change", "value": "Monthly"}]}, "metadata": {"domain": "citydata.mesaaz.gov", "license": "See Terms of Use"}, "permalink": "https://citydata.mesaaz.gov/d/ygkp-e8sz", "link": "https://citydata.mesaaz.gov/Business-Services/Business-Services-Faulty-Utility-Meters/ygkp-e8sz", "owner": {"id": "pxyu-mdaq", "user_type": "interactive", "display_name": "City of Mesa"}, "creator": {"id": "pxyu-mdaq", "user_type": "interactive", "display_name": "City of Mesa"}}
{"resource": {"name": "Feeding Mesa - City of Mesa Food Drive", "id": "ykrb-n55q", "parent_fxf": [], "description": "This dataset details the locations of, and pounds received at fourteen canned food drives throughout the City of Mesa as part of the Mesa Cares Feeding Mesa Program.  Food drives were conducted by City of Mesa Staff and volunteers.  Food received was distributed to United Food Bank and/or Midwest Food Bank for distribution to their constituent agencies. More information about Feeding Mesa program is available at https://www.mesaaz.gov/government/mesa-cares/feeding-mesa", "attribution": "Parks, Recreation and Community Facilities", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2021-07-14T15:32:22.000Z", "createdAt": "2020-07-08T23:08:27.000Z", "metadata_updated_at": "2021-07-14T15:32:17.000Z", "data_updated_at": "2021-07-14T15:32:22.000Z", "columns_name": ["Amount Collected", "Week Beginning Date", "Month", "Week Beginning Month", "Date", "Recipient Agency", "Location", "Week Beginning Year", "Year"], "columns_field_name": ["amount_collected", "week_beginning_date", "month", "week_beginning_month", "date", "recipient_agency", "location", "week_beginning_year", "year"], "columns_datatype": ["Number", "Calendar date", "Text", "Text", "Calendar date", "Text", "Text", "Text", "Text"], "columns_description": ["Number of pounds collected at each location", "Date of the first Monday of the week when the collection happened", "Month of collection", "Month name of first Monday of collection", "Actual date of collection", "Food collected was delivered to United Food Bank and/or Midwest Food Bank for distribution to their constituents", "Location where food collection drive took place at six (6) geographically distinct locations throughout City of Mesa", "Year of first Monday when collection occurred", "Year of collection"], "columns_format": [{}, {"view": "date"}, {}, {}, {"view": "date"}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2020-07-08T23:09:46.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Mesa CARES", "domain_tags": [], "domain_metadata": [{"key": "Public-Access_Public-Access-Level", "value": "Public"}, {"key": "Terms-of-Use_Terms-of-Use", "value": "https://data.mesaaz.gov/stories/s/2dcd-j2nx/"}, {"key": "Frequency_Publishing", "value": "Daily"}, {"key": "Frequency_Data-Change", "value": "Daily"}]}, "metadata": {"domain": "citydata.mesaaz.gov", "license": "See Terms of Use"}, "permalink": "https://citydata.mesaaz.gov/d/ykrb-n55q", "link": "https://citydata.mesaaz.gov/Mesa-CARES/Feeding-Mesa-City-of-Mesa-Food-Drive/ykrb-n55q", "owner": {"id": "pxyu-mdaq", "user_type": "interactive", "display_name": "City of Mesa"}, "creator": {"id": "pxyu-mdaq", "user_type": "interactive", "display_name": "City of Mesa"}}
