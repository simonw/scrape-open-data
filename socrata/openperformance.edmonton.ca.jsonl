{"resource": {"name": "Inflation Rate Edmonton CMA", "id": "u7wz-jhk9", "resource_name": null, "parent_fxf": [], "description": "Changes in Statistics Canada's Consumer Price Index (CPI) measures the rate of price change for goods and services bought by an average consumer in Edmonton.  The CPI does not reflect the type of expenditures required to deliver municipal goods and services, such as construction materials, public transit equipment and professional services. It is worth noting that the CPI is not intended to compare costs of living across jurisdictions.", "attribution": "Statistics Canada", "attribution_link": "https://www150.statcan.gc.ca/t1/tbl1/en/cv.action?pid=1810000411", "contact_email": null, "type": "dataset", "updatedAt": "2023-06-22T16:50:32.000Z", "createdAt": "2014-06-12T19:35:06.000Z", "metadata_updated_at": "2023-06-22T16:50:30.000Z", "data_updated_at": "2023-06-22T16:50:32.000Z", "columns_name": ["YEAR", "MONTH", "ALL_ITEMS_CPI", "REPORT_PERIOD", "DateTime", "Inflation Rate Canada", "ID", "Inflation Rate Alberta", "Inflation Rate - Edmonton CMA"], "columns_field_name": ["year", "month", "all_items_cpi", "report_period", "datetime", "inflation_rate_canada", "id", "inflation_rate_alberta", "inflation_rate"], "columns_datatype": ["Number", "Text", "Number", "Text", "Calendar date", "Number", "Number", "Number", "Number"], "columns_description": ["", "", "", "", "", "", "", "", ""], "columns_format": [{"precisionStyle": "standard", "noCommas": "true", "precision": "0", "align": "left"}, {}, {"precisionStyle": "standard", "noCommas": "false", "align": "left"}, {}, {"view": "date_time", "align": "left"}, {"noCommas": "false", "align": "left", "percentScale": "100", "precisionStyle": "percentage", "view": "percent_text"}, {"precisionStyle": "standard", "noCommas": "false", "align": "left"}, {"noCommas": "false", "align": "left", "percentScale": "100", "precisionStyle": "percentage", "view": "percent_text"}, {"noCommas": "false", "align": "left", "pe