{"resource": {"name": "Sequential Sampling - City of Flint", "id": "xbup-d3a8", "resource_name": null, "parent_fxf": [], "description": "A building's plumbing system and water service line (pipes) can be made up of different types of materials. Each type of material can affect drinking water differently, so it is useful to conduct what is known as \"sequential sampling\". Sequential sampling is where all water usage in a building is stopped for several hours, known as \"stagnation\". Next, water is collected from the faucet in a series of bottles. This is done without wasting any water or running the water before filling the bottles. The first few bottles represent water that was in contact with the faucet or building plumbing during stagnation. The later bottles represent water that was in contact with the water service line. These sample results can help decide whether treatment is working.\n\nLearn more at Michigan.gov/FlintWater", "attribution": "Michigan Department of Environment, Great Lakes, and Energy (EGLE)", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-05-27T13:22:53.000Z", "createdAt": "2021-07-13T18:39:26.000Z", "metadata_updated_at": "2022-05-27T13:22:53.000Z", "data_updated_at": "2022-05-13T11:59:18.000Z", "columns_name": ["Aluminum (Al) mg/L", "Sample Description", "Date Collected", "Lead Result (\u00b5g/L)", "Copper Result (\u00b5g/L)", "Site Number", "Magnesium (Mn) mg/L", "Copper Sample Bottle Size", "Sample Number", "Lead Sample Bottle Size"], "columns_field_name": ["al_mg_l", "sample_description", "date_collected", "lead_result", "copper_result", "site_number", "mn_mg_l", "copper", "sample_number", "lead"], "columns_datatype": ["Text", "Text", "Text", "Number", "Number", "Text", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2021-08-06T15:51:35.000Z"}, "classification": {"categories": ["health"], "tags": [], "domain_category": "Health", "domain_tags": ["copper", "drinking water", "egle", "flint", "lead", "public water system"], "domain_metadata": []}, "metadata": {"domain": "data.michigan.gov"}, "permalink": "https://data.michigan.gov/d/xbup-d3a8", "link": "https://data.michigan.gov/Health/Sequential-Sampling-City-of-Flint/xbup-d3a8", "owner": {"id": "cg34-2x99", "user_type": "team", "display_name": "EGLE Drinking Water and Environmental Health Division (DWEHD)"}, "creator": {"id": "cg34-2x99", "user_type": "team", "display_name": "EGLE Drinking Water and Environmental Health Division (DWEHD)"}}
