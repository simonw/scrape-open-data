{"resource": {"name": "City of Albany Crime Data(Feb.-Apr.2020)", "id": "qt5m-6kxz", "parent_fxf": [], "description": "All crime data on openAlbany is preliminary data and subject to change. The information presented through openAlbany represents Part I victim based crime data. The data does not represent statistics submitted to the FBI's Uniform Crime Report (UCR); therefore any comparisons are strictly prohibited. For further clarification of UCR data, please visit http://www.fbi.gov/about-us/cjis/ucr/ucr. Please note that this data is preliminary and subject to change. Prior month data is likely to show changes when it is refreshed on a monthly basis. All data is geocoded to the approximate latitude/longitude location of the incident and excludes those records for which an address could not be geocoded. Any attempt to match the approximate location of the incident to an exact address is strictly prohibited.", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2020-05-08T13:13:48.000Z", "createdAt": "2020-05-08T12:59:55.000Z", "metadata_updated_at": "2020-05-08T13:13:48.000Z", "data_updated_at": "2020-05-08T13:13:42.000Z", "columns_name": ["Neighborhood Associations", "ADDRESS TYPE", "HUNDRED BLOCK", "UNIFORM CRIME REPORT", "LOCATION TYPE", "REPORT DATE", "REPORT DAY", "INCIDENT NUMBER", "APD Patrol Zones Dataset", "CRIME CLASSIFICATION"], "columns_field_name": [":@computed_region_84ez_q8p4", "geocoded_column", "hundred_block", "uniform_crime_report", "location_type", "report_date", "report_day", "incident_number", ":@computed_region_9tnd_vhch", "crime_classification"], "columns_datatype": ["Number", "Point", "Text", "Text", "Text", "Calendar date", "Text", "Text", "Number", "Text"], "columns_description": ["", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2020-05-08T13:13:48.000Z"}, "classification": {"categories": ["public safety"], "tags": [], "domain_category": "Public Safety", "domain_tags": ["crime data", "crime location", "police report"], "domain_metadata": []}, "metadata": {"domain": "data.albanyny.gov"}, "permalink": "https://data.albanyny.gov/d/qt5m-6kxz", "link": "https://data.albanyny.gov/Public-Safety/City-of-Albany-Crime-Data-Feb-Apr-2020-/qt5m-6kxz", "owner": {"id": "6vr8-kwcz", "user_type": "interactive", "display_name": "openAlbany Team"}, "creator": {"id": "6vr8-kwcz", "user_type": "interactive", "display_name": "openAlbany Team"}}
