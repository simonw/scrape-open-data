{"resource": {"name": "Crime Responses", "id": "gvua-xt9q", "resource_name": null, "parent_fxf": [], "description": "Disclaimer:\nCrime Responses is provided by the Gainesville Police Department (GPD) to document initial details surrounding an incident to which GPD officers respond. This dataset contains crime incidents from 2011 to present and includes a reduced set of fields focused on capturing the type of incident as well when and where an incident occurred.\nThe Incident location addresses have been rounded off and are not the exact location due to the constitutional amendment known as \"Marsy's Law\".\n\nIn 2021, Florida reporting of crime data began a transition from Summary Reporting System (SRS) to National Incident-Based Reporting System (NIBRS), causing an effect on crime statistics reported by Law Enforcement Agencies such as the Gainesville Police Department who made this transition on November 16, 2021.  The effect would be an increase in crime due to the elimination of the SRS Hierarchy Rule which collected only the most serious offense in an incident while NIBRS will now capture up to 10 offenses per incident and specifies more offense categories than SRS.  The inclusion of these crimes, particularly property crimes, will reflect an increase in crime when switching from SRS reporting to NIBRS' reporting.  The apparent increase (usually not greater than 2.7%) is simply due to the difference between how crimes are counted in NIBRS versus the SRS and its application of the Hierarchy Rule.  More information regarding NIBRS effect on crime statistics can be found on the following link:  https://ucr.fbi.gov/nibrs/2014/resource-pages/effects_of_nibrs_on_crime_statistics_final.pdf.", "attribution": "Gainesville Police Department", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-11-05T17:15:09.000Z", "createdAt": "2014-11-20T13:40:37.000Z", "metadata_updated_at": "2024-11-05T17:15:09.000Z", "data_updated_at": "2024-11-05T17:15:09.000Z", "columns_name": ["Offense Date", "Report Date", "Report Hour of Day", "Offense Hour of Day", "Latitude", "State", "Incident Type", "ID", "City", "Longitude", "Gainesville Fire Response Districts", "GPD Zones", "Gainesville Enterprise Zone Boundaries", "Report Day of Week", "2010 Census Tracts", "Zip Code Boundaries", "Florida Census Zip Codes", "Gainesville Police Districts", "Commission Districts", "Location", "Offense Day of Week", "Address"], "columns_field_name": ["offense_date", "report_date", "report_hour_of_day", "offense_hour_of_day", "latitude", "state", "narrative", "id", "city", "longitude", ":@computed_region_ndi2_bfht", ":@computed_region_43jd_v64e", ":@computed_region_9cfm_spy5", "report_day_of_week", ":@computed_region_e6r8_dw75", ":@computed_region_ecgy_hwrz", ":@computed_region_4rat_gsiv", ":@computed_region_u9vc_vmbc", ":@computed_region_axii_i744", "location", "offense_day_of_week", "address"], "columns_datatype": ["Calendar date", "Calendar date", "Number", "Number", "Number", "Text", "Text", "Number", "Text", "Number", "Number", "Number", "Number", "Text", "Number", "Number", "Number", "Number", "Number", "Point", "Text", "Text"], "columns_description": ["Date and time of the offense.", "Date and time that the incident report was filed. ", "Hour of the day when the offense was reported.", "Hour of day when the offense took place.", "Latitude of the street block where the offense took place.", "State where the incident occurred. ", "Type of incident that occured.", "Incident identification number. ", "City where the incident occurred. ", "Longitude of the street block where the offense took place.", "", "", "", "Day of the week when the offense was reported.", "", "", "", "", "", "Geo-coded point of the street block where the offense took place.", "Day of the week when the offense took place.", "Location of the offense approximated to street block."], "columns_format": [{"view": "date_time", "align": "left"}, {"view": "date_time", "align": "left"}, {}, {}, {}, {"align": "left"}, {"align": "left"}, {"precisionStyle": "standard", "noCommas": "true", "align": "right"}, {"align": "left"}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2019-07-08T18:37:16.000Z"}, "classification": {"categories": ["public safety"], "tags": [], "domain_category": "Public Safety", "domain_tags": [], "domain_metadata": []}, "metadata": {"domain": "data.cityofgainesville.org", "license": "Public Domain"}, "permalink": "https://data.cityofgainesville.org/d/gvua-xt9q", "link": "https://data.cityofgainesville.org/Public-Safety/Crime-Responses/gvua-xt9q", "owner": {"id": "29ia-uura", "user_type": "interactive", "display_name": "COG Socrata Admins"}, "creator": {"id": "29ia-uura", "user_type": "interactive", "display_name": "COG Socrata Admins"}}
