{"resource": {"name": "Code Complaints, Violations & Permits", "id": "vu9p-a5f7", "parent_fxf": [], "description": "The Code Enforcement Division enforces:\n\n- Housing and Commercial Building Codes (Chapter 13)\n- Rental Housing Permits (Chapter 14.5)\n- Nuisance Codes (Chapter 16)\n- Abandoned Vehicles on private property (Chapter 26)\n- Land Development Code (Chapter 30)\n- Graffiti (Chapter 13)\nThis report lists, code complaints, violations and permits. \nData is updated monthly and dates back to  February 2011.\nPlease note that addresses that are listed under the Location field as 0 W 1ST ST are null place-holders and are not accurate addresses.", "attribution": "Code Enforcement", "attribution_link": "https://data.cityofgainesville.org/Building-Development/Code-Complaints-Violations/vu9p-a5f7", "contact_email": null, "type": "dataset", "updatedAt": "2023-07-18T17:48:01.000Z", "createdAt": "2013-11-12T17:41:42.000Z", "metadata_updated_at": "2023-07-18T17:47:39.000Z", "data_updated_at": "2023-07-18T17:48:01.000Z", "columns_name": ["location", "Case Status", "Outstanding Inspection", "City Commission Districts", "2010 Census Tracts", "Gainesville_Commission_Districts_from_jw7m_7ges", "Commission Districts", "GPD Zones", "Gainesville Police Districts", "Florida Census Zip Codes", "Gainesville Fire Response Districts", "Case Type", "Parcel Number", "Number", "Infraction Date", "Primary Party", "Inspector", "Address", "Geocode"], "columns_field_name": ["location", "status", "outstanding_inspection", ":@computed_region_4x5c_ywwx", ":@computed_region_e6r8_dw75", ":@computed_region_qsqf_gz5q", ":@computed_region_axii_i744", ":@computed_region_43jd_v64e", ":@computed_region_u9vc_vmbc", ":@computed_region_4rat_gsiv", ":@computed_region_ndi2_bfht", "case_type", "parcel", "number", "infraction", "primary_party", "inspector", "address", "geocode"], "columns_datatype": ["Point", "Text", "Text", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Text", "Text", "Text", "Calendar date", "Text", "Text", "Text", "Point"], "columns_description": ["", "Current status of response to complaint received.", "", "This column was automatically created in order to record in what polygon from the dataset 'City Commission Districts' (4x5c-ywwx) the point in column 'geocode' is located.  This enables the creation of region maps (choropleths) in the visualization canvas and data lens.", "This column was automatically created in order to record in what polygon from the dataset '2010 Census Tracts' (e6r8-dw75) the point in column 'geocode' is located.  This enables the creation of region maps (choropleths) in the visualization canvas and data lens.", "", "", "", "", "", "", "Description of case per the complaint received or violation identified.", "", "", "Date when violation identified or investigation occurred.", "", "", "Address of the complaint or violation. ", ""], "columns_format": [{}, {"align": "left"}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {"align": "left"}, {"align": "right"}, {}, {"view": "date", "align": "left"}, {}, {}, {"align": "left"}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-04-21T16:13:25.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Building & Development", "domain_tags": ["code", "complaint", "enforcement", "violation"], "domain_metadata": []}, "metadata": {"domain": "data.cityofgainesville.org", "license": "Public Domain"}, "permalink": "https://data.cityofgainesville.org/d/vu9p-a5f7", "link": "https://data.cityofgainesville.org/Building-Development/Code-Complaints-Violations-Permits/vu9p-a5f7", "owner": {"id": "rz5q-7myg", "user_type": "interactive", "display_name": "Elin Philpot"}, "creator": {"id": "rz5q-7myg", "user_type": "interactive", "display_name": "Elin Philpot"}}
