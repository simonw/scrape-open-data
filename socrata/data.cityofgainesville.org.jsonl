{"resource": {"name": "Code Complaints, Violations & Permits", "id": "vu9p-a5f7", "parent_fxf": [], "description": "The Code Enforcement Division enforces:\n\n- Housing and Commercial Building Codes (Chapter 13)\n- Rental Housing Permits (Chapter 14.5)\n- Nuisance Codes (Chapter 16)\n- Abandoned Vehicles on private property (Chapter 26)\n- Land Development Code (Chapter 30)\n- Graffiti (Chapter 13)\nThis report lists, code complaints, violations and permits. \nData is updated monthly and dates back to  February 2011.\nPlease note that addresses that are listed under the Location field as 0 W 1ST ST are null place-holders and are not accurate addresses.", "attribution": "Code Enforcement", "attribution_link": "https://data.cityofgainesville.org/Building-Development/Code-Complaints-Violations/vu9p-a5f7", "contact_email": null, "type": "dataset", "updatedAt": "2022-09-27T17:33:56.000Z", "createdAt": "2013-11-12T17:41:42.000Z", "metadata_updated_at": "2022-09-27T17:33:43.000Z", "data_updated_at": "2022-09-27T17:33:56.000Z", "columns_name": ["City Commission Districts", "Outstanding Inspection", "Case Status", "Number", "Parcel Number", "Inspector", "Infraction Date", "Gainesville Police Districts", "Florida Census Zip Codes", "Primary Party", "Address", "Case Type", "Geocode", "location", "Gainesville Fire Response Districts", "Commission Districts", "GPD Zones", "Gainesville_Commission_Districts_from_jw7m_7ges", "2010 Census Tracts"], "columns_field_name": [":@computed_region_4x5c_ywwx", "outstanding_inspection", "status", "number", "parcel", "inspector", "infraction", ":@computed_region_u9vc_vmbc", ":@computed_region_4rat_gsiv", "primary_party", "address", "case_type", "geocode", "location", ":@computed_region_ndi2_bfht", ":@computed_region_axii_i744", ":@computed_region_43jd_v64e", ":@computed_region_qsqf_gz5q", ":@computed_region_e6r8_dw75"], "columns_datatype": ["Number", "Text", "Text", "Text", "Text", "Text", "Calendar date", "Number", "Number", "Text", "Text", "Text", "Point", "Point", "Number", "Number", "Number", "Number", "Number"], "columns_description": ["This column was automatically created in order to record in what polygon from the dataset 'City Commission Districts' (4x5c-ywwx) the point in column 'geocode' is located.  This enables the creation of region maps (choropleths) in the visualization canvas and data lens.", "", "Current status of response to complaint received.", "", "", "", "Date when violation identified or investigation occurred.", "", "", "", "Address of the complaint or violation. ", "Description of case per the complaint received or violation identified.", "", "", "", "", "", "", "This column was automatically created in order to record in what polygon from the dataset '2010 Census Tracts' (e6r8-dw75) the point in column 'geocode' is located.  This enables the creation of region maps (choropleths) in the visualization canvas and data lens."], "columns_format": [{}, {}, {"align": "left"}, {}, {"align": "right"}, {}, {"view": "date", "align": "left"}, {}, {}, {}, {"align": "left"}, {"align": "left"}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-04-21T16:13:25.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Building & Development", "domain_tags": ["code", "complaint", "enforcement", "violation"], "domain_metadata": []}, "metadata": {"domain": "data.cityofgainesville.org", "license": "Public Domain"}, "permalink": "https://data.cityofgainesville.org/d/vu9p-a5f7", "link": "https://data.cityofgainesville.org/Building-Development/Code-Complaints-Violations-Permits/vu9p-a5f7", "owner": {"id": "rz5q-7myg", "user_type": "interactive", "display_name": "Elin Philpot"}, "creator": {"id": "rz5q-7myg", "user_type": "interactive", "display_name": "Elin Philpot"}}
