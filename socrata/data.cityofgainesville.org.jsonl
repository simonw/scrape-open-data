{"resource": {"name": "Code Complaints, Violations & Permits", "id": "vu9p-a5f7", "resource_name": null, "parent_fxf": [], "description": "The Code Enforcement Division enforces:\n\n- Housing and Commercial Building Codes (Chapter 13)\n- Rental Housing Permits (Chapter 14.5)\n- Nuisance Codes (Chapter 16)\n- Abandoned Vehicles on private property (Chapter 26)\n- Land Development Code (Chapter 30)\n- Graffiti (Chapter 13)\nThis report lists, code complaints, violations and permits. \nData is updated monthly and dates back to  February 2011.\nPlease note that addresses that are listed under the Location field as 0 W 1ST ST are null place-holders and are not accurate addresses.", "attribution": "Code Enforcement", "attribution_link": "https://data.cityofgainesville.org/Building-Development/Code-Complaints-Violations/vu9p-a5f7", "contact_email": null, "type": "dataset", "updatedAt": "2023-07-18T17:48:01.000Z", "createdAt": "2013-11-12T17:41:42.000Z", "metadata_updated_at": "2023-07-18T17:47:39.000Z", "data_updated_at": "2023-07-18T17:48:01.000Z", "columns_name": ["2010 Census Tracts", "City Commission Districts", "Outstanding Inspection", "Case Status", "location", "Geocode", "Address", "Inspector", "Primary Party", "Infraction Date", "Number", "Parcel Number", "Case Type", "Gainesville Police Districts", "Florida Census Zip Codes", "Gainesville Fire Response Districts", "Commission Districts", "GPD Zones", "Gainesville_Commission_Districts_from_jw7m_7ges"], "columns_field_name": [":@computed_region_e6r8_dw75", ":@computed_region_4x5c_ywwx", "outstanding_inspection", "status", "location", "geocode", "address", "inspector", "primary_party", "infraction", "number", "parcel", "case_type", ":@computed_region_u9vc_vmbc", ":@computed_region_4rat_gsiv", ":@computed_region_ndi2_bfht", ":@computed_region_axii_i744", ":@computed_region_43jd_v64e", ":@computed_region_qsqf_gz5q"], "columns_datatype": ["Number", "Number", "Text", "Text", "Point", "Point", "Text", "Text", "Text", "Ca