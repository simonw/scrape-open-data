{"resource": {"name": "Fulton County Jail Bookings (Public)", "id": "ey9v-j62i", "resource_name": null, "parent_fxf": [], "description": "This dataset consists of a record for each booking into one of the Fulton County detention facilities since January 2014. Each record includes the date and time of the booking; the facility at which the person was booked; and the law enforcement agency that delivered the person. If the person was released, also included is the release date and time and the reason for release.", "attribution": "Fulton County Government (GA)", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2025-01-26T22:21:28.000Z", "createdAt": "2023-03-29T14:40:19.000Z", "metadata_updated_at": "2025-01-26T22:21:13.000Z", "data_updated_at": "2025-01-26T22:21:28.000Z", "columns_name": ["GroupOrder", "ReleaseType", "ReleaseDate", "ID", "DaysinCustody", "DeliveryAgency", "NodeID", "Over180Days", "Location", "BookingDate", "Year", "Over365Days", "Group", "Degree"], "columns_field_name": ["grouporder", "releasetype", "releasedate", "id", "daysincustody", "deliveryagency", "nodeid", "over180days", "location", "bookingdate", "year", "over365days", "group", "degree"], "columns_datatype": ["Number", "Text", "Calendar date", "Number", "Number", "Text", "Number", "Number", "Text", "Calendar date", "Number", "Number", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{"decimalSeparator": ".", "groupSeparator": ","}, {}, {}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {}, {}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_dat