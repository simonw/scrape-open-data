{"resource": {"name": "COVID-19 Case & Death Trends by Date", "id": "nfta-sjx6", "parent_fxf": [], "description": "This is an archived dataset & will no longer be updated. Case and Death data related to COVID-19. \n\n*As of April 1, 2022 MODHSS is no longer providing negative test data. As a result we will no longer publish total tests per day* \n\nCases are based on the date an individual was tested for COVID-19. Using date tested means counts for most recent dates are likely to change as tests are reported to the the Health Department. Cases include those without an address assigned to KCMO by MODHSS to investigate. Antigen tests are not included at this time.\nDeaths are based on the date the death was reported to the Health Department. \n\nAdditional data available in the link below.\nData definitions are also available in the link below.", "attribution": "Kansas City, MO Health Department", "attribution_link": "https://www.kcmo.gov/city-hall/departments/health/coronavirus-covid-19/covid-19-totals", "contact_email": null, "type": "dataset", "updatedAt": "2023-12-28T21:30:27.000Z", "createdAt": "2020-08-18T22:49:15.000Z", "metadata_updated_at": "2023-12-28T21:30:27.000Z", "data_updated_at": "2022-12-08T19:12:19.000Z", "columns_name": ["New Cases", "Date", "Total Deaths", "New Deaths", "Total Cases"], "columns_field_name": ["new_cases", "date", "total_deaths", "new_deaths", "total_cases"], "columns_datatype": ["Number", "Calendar date", "Number", "Number", "Number"], "columns_description": ["Number of new COVID-19 cases based on date tested", "date and time", "Total number of deaths due to COVID-19 or where COVID-19 was a significant contributing factor", "Number of new deaths due to COVID-19 or where COVID-19 was a significant contributing factor, based on date of death", "Total number of COVID-19 cases for Kansas City, MO"], "columns_format": [{}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2021-11-19T20:27:12.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Health", "domain_tags": ["covid19"], "domain_metadata": []}, "metadata": {"domain": "data.kcmo.org"}, "permalink": "https://data.kcmo.org/d/nfta-sjx6", "link": "https://data.kcmo.org/Health/COVID-19-Case-Death-Trends-by-Date/nfta-sjx6", "owner": {"id": "edts-pa55", "user_type": "interactive", "display_name": "Alex Francisco"}, "creator": {"id": "edts-pa55", "user_type": "interactive", "display_name": "Alex Francisco"}}
{"resource": {"name": "Dangerous Buildings List", "id": "ax3m-jhxx", "parent_fxf": [], "description": "Updated daily. Dangerous Buildings cases are evaluated in accordance with building code standards to determine if they are a candidate for demolition. Private owners are generally given at least 30 days to conduct work to repair or demolish their property before the City will take action. The more severe the damage, the shorter the timeline the property owner has to avoid City action, which can include municipal court summons, fines, and demolition by City contractors (the cost of which is then assessed against the property owner).", "attribution": "KCMO Neighborhoods and Housing Services", "attribution_link": "http://kcmo.org/CKCMO/Depts/NeighborhoodsandHousingServices/HousingPreservation/DangerousBuildings/", "contact_email": null, "type": "dataset", "updatedAt": "2024-08-20T19:02:12.000Z", "createdAt": "2013-08-16T15:10:10.000Z", "metadata_updated_at": "2024-08-20T19:02:05.000Z", "data_updated_at": "2024-08-20T19:02:12.000Z", "columns_name": ["Case Number", "PIN", "Neighborhood Census", "Location (zip)", "Location (state)", "Location (city)", "Location", "Location (address)", "Longitude", "Council Districts", "County Boundary", "Zip Codes", "Public Works Maintenance Districts", "Latitude", "City Council Districts (effective 2023)", "Council District", "Status of Case", "Case Opened", "ZIP Code", "Address"], "columns_field_name": ["casenumber", "pin", ":@computed_region_kk66_ngf4", "location_zip", "location_state", "location_city", "location", "location_address", "longitude", ":@computed_region_9t2m_phkm", ":@computed_region_my34_vmp8", ":@computed_region_w4hf_t6bp", ":@computed_region_k7in_q28t", "latitude", ":@computed_region_qizh_zmq5", "council_district", "statusofcase", "case_opened", "zip_code", "address"], "columns_datatype": ["Text", "Number", "Number", "Text", "Text", "Text", "Point", "Text", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Text", "Text", "Calendar date", "Text", "Text"], "columns_description": ["The case number, currently a Service Order in PeopleSoft CRM. 7 digits, sequential, may not be blank.", "The Parcel Identification Number (formerly called KIVAPIN) of the parcel on which the dangerous building resides. Unique.", "", "", "", "", "Full address of the dangerous building, with City, State, and ZIP.", "", "", "", "", "", "", "", "This column was automatically created in order to record in what polygon from the dataset 'City Council Districts (effective 2023)' (qizh-zmq5) the point in column 'location' is located.  This enables the creation of region maps (choropleths) in the visualization canvas and data lens.", "", "", "When was the City's case against the dangerous building opened. There may have been earlier cases in other departments.", "The ZIP Code of the dangerous building. May be blank if unknown.", "The physical address of the dangerous building. May be approximate or a range, for example '2010-2012 Agnes'."], "columns_format": [{"precisionStyle": "standard", "noCommas": "true", "align": "right"}, {"precisionStyle": "standard", "noCommas": "true", "align": "right"}, {}, {}, {}, {}, {"view": "address_coords", "align": "left"}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {"align": "left"}, {"view": "date", "align": "left"}, {"align": "left"}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2023-07-26T20:54:18.000Z"}, "classification": {"categories": ["housing & development"], "tags": [], "domain_category": "Neighborhoods", "domain_tags": ["bdkc", "condemnation", "condemned", "dangerous buildings", "db", "demolition", "neighborhood", "property"], "domain_metadata": []}, "metadata": {"domain": "data.kcmo.org", "license": "Public Domain"}, "permalink": "https://data.kcmo.org/d/ax3m-jhxx", "link": "https://data.kcmo.org/Neighborhoods/Dangerous-Bu