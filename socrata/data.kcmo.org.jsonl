{"resource": {"name": "Litter Index", "id": "xykx-tzcr", "parent_fxf": [], "description": "The Litter Index is a sophisticated tool designed by Keep America Beautiful, which is in use across the nation to measure the amount of visible litter in a community.  Teams of volunteers drive through communities and survey a random, statistical sample of five percent of all street segments in the city. Then Geographic Information Systems (GIS) software is used to map the results.", "attribution": "Bridging the Gap", "attribution_link": "https://www.bridgingthegap.org/litter-index/", "contact_email": null, "type": "dataset", "updatedAt": "2023-12-28T20:23:29.000Z", "createdAt": "2014-06-12T15:38:43.000Z", "metadata_updated_at": "2023-12-28T20:23:29.000Z", "data_updated_at": "2014-06-18T17:52:03.000Z", "columns_name": ["Year", "Date", "Litter Index Rating"], "columns_field_name": ["year", "date", "litter_index_rating"], "columns_datatype": ["Number", "Calendar date", "Number"], "columns_description": ["", "", ""], "columns_format": [{"precisionStyle": "standard", "rdf": "", "noCommas": "true", "align": "right"}, {}, {"precisionStyle": "standard", "noCommas": "false", "precision": "2", "align": "right"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2014-06-18T17:52:08.000Z"}, "classification": {"categories": ["infrastructure"], "tags": [], "domain_tags": ["index", "litter", "litter index"], "domain_metadata": []}, "metadata": {"domain": "data.kcmo.org", "license": "Public Domain"}, "permalink": "https://data.kcmo.org/d/xykx-tzcr", "link": "https://data.kcmo.org/dataset/Litter-Index/xykx-tzcr", "owner": {"id": "p5d5-8ryp", "user_type": "interactive", "display_name": "DataKC"}, "creator": {"id": "p5d5-8ryp", "user_type": "interactive", "display_name": "DataKC"}}
