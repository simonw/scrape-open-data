{"resource": {"name": "Connecticut Vital Records \u2014 Index of Marriages, 1897-2001", "id": "fy7b-hj53", "resource_name": "MarriageRecordsIndex", "parent_fxf": [], "description": "Connecticut Vital Records \u2014 Index of Marriages, 1897-2001\n\nThis index allows researchers to find the name, place and date of marriage for couples who were married in Connecticut between 1897 through 2001. The information from this index can be used to request a copy of a marriage certificate from the <A HREF=\"https://portal.ct.gov/cities_and_towns/\">Town/City Clerk of the municipality</a> listed in the search results. Order forms for vital records requests can be found at <a href=\"https://portal.ct.gov/dph/vital-records/applications-and-forms\">this link</a>.\n\nThere is no guarantee that the information contained in the index is accurate and the State of Connecticut has no legal liability for any claims resulting from reliance on this information.", "attribution": "State Vital Records Office / Connecticut State Library", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-07-01T15:22:05.000Z", "createdAt": "2024-06-28T18:04:59.000Z", "metadata_updated_at": "2024-07-01T15:22:05.000Z", "data_updated_at": "2024-06-28T18:26:07.000Z", "columns_name": ["BRIDE SURNAME", "BRIDE FIRST NAME", "CITY/TOWN", "GROOM SURNAME", "GROOM FIRST NAME", "DATE"], "columns_field_name": ["bride_surname", "bride_first_name", "city_town", "groom_surname", "groom_first_name", "date"], "columns_datatype": ["Text", "Text", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2024-06-28T18:13:01.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "History", "domain_tags": ["csl", "ct state library", "marriage records", "marriages", "vital records"], "domain_metadata": [{"key": "Agency_Agency", "value": "Connecticut State Library"}, {"key": "Details_Geographic-Unit", "value": "State"}, {"key": "Details_Update-Frequency", "value": "Not updated (historical data)"}]}, "metadata": {"domain": "internal-ct.data.socrata.com"}, "permalink": "https://internal-ct.data.socrata.com/d/fy7b-hj53", "link": "https://internal-ct.data.socrata.com/History/Connecticut-Vital-Records-Index-of-Marriages-1897-/fy7b-hj53", "owner": {"id": "v2nz-ybna", "user_type": "team", "display_name": "CT State Library"}, "creator": {"id": "v2nz-ybna", "user_type": "team", "display_name": "CT State Library"}}
