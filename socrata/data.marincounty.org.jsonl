{"resource": {"name": "COVID-19 Cumulative Demographics", "id": "uu8g-ckxh", "parent_fxf": [], "description": "Provides the proportion of COVID-19 Cases, Hospitalizations, and Deaths by Age, Gender, and Race/Ethnicity categories.\n\nNote: Between 1/1/2022 and 3/4/2022 hospitalization counts did not include in-patient hospitalizations with a COVID-19 positive test when the patient was in the hospital for a reason other than COVID-19. This included in-patient stays due to labor/delivery, trauma, or emergency surgery. Hospitalization reporting was modified to represent the disease severity of the Omicron variant accurately. As of 3/5/2022, we have resumed publishing the CDPH daily hospitalized patient census, which includes all in-patient hospitalizations with a COVID-19 positive test.", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-07-30T03:00:49.000Z", "createdAt": "2020-12-04T01:04:44.000Z", "metadata_updated_at": "2022-03-09T17:40:07.000Z", "data_updated_at": "2022-07-30T03:00:49.000Z", "columns_name": ["Total Hospitalized", "Grouping", "Last Updated", "Total Deaths", "Total Cases"], "columns_field_name": ["hospitalized", "grouping", "last_updated", "deaths", "cumulative"], "columns_datatype": ["Number", "Text", "Calendar date", "Number", "Number"], "columns_description": ["", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2020-12-23T23:05:59.000Z"}, "classification": {"categories": ["demographics"], "tags": [], "domain_category": "Public Health", "domain_tags": ["covid", "covid-19", "public health"], "domain_metadata": [{"key": "Dataset-Information_Department", "value": "Health & Human Services"}, {"key": "Dataset-Information_Data-Source", "value": "SQL Database"}, {"key": "Dataset-Information_Update-Frequency", "value": "Daily"}]}, "me