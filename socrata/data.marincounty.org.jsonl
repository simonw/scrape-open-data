{"resource": {"name": "Adult Probation Program Completion", "id": "uy69-6ga6", "parent_fxf": [], "description": "Closed, adult probation programs overseen by the Probation Department of Marin County, CA.  Data is updated daily.  Program end dates cover the time period beginning January 2016 until the present.\n\nProbation programs for each adult include Parole, Investigation, Supervision, Adult Offender Work Program, Restitution, AB 109 and more.  Also included are gender, age range at time of program end, demographic information, an indicator of program success, and city/town and zipcode at time of program end.", "attribution": "County of Marin, CA", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-07-29T11:40:04.000Z", "createdAt": "2020-05-13T23:11:50.000Z", "metadata_updated_at": "2020-07-03T00:15:03.000Z", "data_updated_at": "2022-07-29T11:40:04.000Z", "columns_name": ["Successful", "Program Name", "Open Data Person Number", "Program Start Date", "Program End Date", "Program Status", "Gender", "Age Range", "Ethnicity", "Zipcode", "Unique ID"], "columns_field_name": ["successful_completion_value", "program_type_name", "opendata_person_number", "program_begin_date", "program_end_date", "program_status_name", "sex", "age_range", "race_name", "zipcode", "unique_id"], "columns_datatype": ["Text", "Text", "Number", "Calendar date", "Calendar date", "Text", "Text", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {"noCommas": "true"}, {"view": "date"}, {"view": "date"}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2020-06-01T20:11:04.000Z"}, "classification": {"categories": ["demographics", "public safety"], "tags": [], "domain_category": "Public Safety", "domain_tags": ["safety", "probation", "parole", "misdemeano