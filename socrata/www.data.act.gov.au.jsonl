{"resource": {"name": "EPA Authorisations Public Register", "id": "yntp-rvcu", "parent_fxf": [], "description": "Under the Environment Protection Act 1997 (Section 41A), it is a requirement that certain activities that pose environmental risk call for an Environmental Authorisation. Environmental Authorisations are one of the most important regulatory tools available to the EPA, as they set out conditions for activities carrying with them the greatest environmental risk. Each authorisation can be individually tailored for the activity it authorises, and can impose specific conditions on the conduct of the activity.", "attribution": "ACT Government", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2023-01-12T16:10:12.000Z", "createdAt": "2018-09-21T02:54:05.000Z", "metadata_updated_at": "2021-11-18T03:12:29.000Z", "data_updated_at": "2023-01-12T16:10:12.000Z", "columns_name": ["CeaseExpiryDate", "PartyName", "AuthorisationNo", "Date", "Activity", "Suburb", "Status", "PDF"], "columns_field_name": ["ceaseexpirydate", "partyname", "authorisationno", "date", "activity", "suburb", "status", "pdf"], "columns_datatype": ["Calendar date", "Text", "Text", "Calendar date", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2018-11-05T01:32:30.000Z"}, "classification": {"categories": ["environment"], "tags": [], "domain_category": "Environment", "domain_tags": [], "domain_metadata": [{"key": "Contributing-Agency_Agency-Name", "value": "Access Canberra"}, {"key": "Contributing-Agency_Directorate", "value": "Chief Minister, Treasury and Economic Development"}, {"key": "Contributing-Agency_Contact-Email", "value": "cxsupport@act.gov.au"}, {"key": "Contributing-Agency_Program-Website", "value": "https: