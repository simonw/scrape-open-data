{"resource": {"name": "Spending Information for FY 2021", "id": "rh7w-bmhm", "resource_name": null, "parent_fxf": [], "description": "This dataset allows you to view information about government spending. Disclosure of payments is based on the legislative requirements of CB-19-2011 which can be accessed via https://princegeorgescountymd.legistar.com/Legislation.aspx, which is an effort to provide enhanced transparency and convenient public access to this information. Certain expenditures are subject to review on a case-by-case basis to ensure that confidential or privileged material is maintained in accordance with legal requirements. As such, these expenditures may not appear on this website.\n\nUnaudited data is updated quarterly for all payees with combined spending of $25,000 or more. When cumulative payee spending exceeds $25,000 threshold, all payments made during the Fiscal Year will be reported. Datasets, current and up to seven prior fiscal periods, will be available for your search by Fiscal Year. The following information will be displayed: Payee Name, County Agency Name, Payee Zip Code, Amount and Payment Description. Website options include: sorting, exporting data, creating graphs, and customizing your display format - among other features. There is an online tutorial.\n\nIf you have any questions or comments about this citizen portal site, please send an email at any time to: CountyClick311@co.pg.md.us, or call 3-1-1 (301-883-4748), Monday - Friday, 7am - 7pm, and a Customer Service Representative will be glad to assist you.\nLess", "attribution": "SAP/OIT Data Warehouse", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2021-05-27T19:25:09.000Z", "createdAt": "2021-04-23T19:54:12.000Z", "metadata_updated_at": "2021-05-27T19:25:07.000Z", "data_updated_at": "2021-05-27T19:25:09.000Z", "columns_name": ["payee_name", "zip_code", "payment_description", "amount", "agency"], "columns_field_name": ["payee_name", "zip_code", "payment_description", "amount", "agency"], "columns_datatype": ["Text", "Text", "Text", "Number", "Text"], "columns_description": ["", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2021-04-23T19:58:21.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Finance and Budget", "domain_tags": [], "domain_metadata": [{"key": "Time-Period_Update-Frequency", "value": "Quaterly"}]}, "metadata": {"domain": "data.princegeorgescountymd.gov"}, "permalink": "https://data.princegeorgescountymd.gov/d/rh7w-bmhm", "link": "https://data.princegeorgescountymd.gov/Finance-and-Budget/Spending-Information-for-FY-2021/rh7w-bmhm", "owner": {"id": "w8ik-7weh", "user_type": "interactive", "display_name": "Manish Mamidi"}, "creator": {"id": "w8ik-7weh", "user_type": "interactive", "display_name": "Manish Mamidi"}}
