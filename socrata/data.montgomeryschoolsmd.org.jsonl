{"resource": {"name": "FY2016 MCPS Operating Budget", "id": "u7b4-7dy2", "parent_fxf": [], "description": "FY2016 MCPS Operating Budget", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2016-01-21T18:34:43.000Z", "createdAt": "2014-12-23T17:11:47.000Z", "metadata_updated_at": "2016-01-21T18:34:43.000Z", "data_updated_at": "2015-07-07T14:11:53.000Z", "columns_name": ["Recommended FTE Positions", "Adopted Amount", "Fiscal Year", "Office-Dept-Div-Unit-Program", "State Category Name", "Expenditure Account", "Budget Chapter", "Approved Amount", "Adopted FTE Positions", "Major Object of Expenditure", "Approved FTE Positions", "State Category", "Recommended Amount"], "columns_field_name": ["full_time_equivalent_positions", "adopted_amount", "fiscal_year", "office_dept_div_unit_program", "state_category_name", "expenditure_account", "budget_chapter", "approved_amount", "adopted_fte_positions", "major_object_of_expenditure", "approved_fte_positions", "state_category", "recommended_amount"], "columns_datatype": ["Number", "Number", "Text", "Text", "Text", "Text", "Text", "Number", "Number", "Text", "Number", "Number", "Number"], "columns_description": ["A full-time equivalent position, or FTE, corresponds to the number of hours a budgeted position is scheduled to work.  A 1.0 FTE works full time, or 40 hours per week.", "In March, the Board of Education adopts its budget and sends its Requested Fiscal Year Operating Budget to the county executive.", "", "These are organizational units and programs that are contained within each of the budget chapters.", "State law requires all education agencies to appropriate and record expenditures in accordance with standardized budget categories.  More information on state categories is available in MCPS operating budget documents.", "The expenditure account name describes, at the most detailed level, the purpose of the budgeted funds.", "There are 11 chapters in the Operating Budget document that are aligned with MCPS\u2019s organizational chart. ", "By March 15th, the county executive must submit his budget to the County Council, which includes recommendations for MCPS.  The County Council appropriates the budget in May, including the budget for MCPS by state category.  In June, the Board of Education adopts the approved budget for MCPS which must equal the total budget by state category appropriated by the County Council.  The Board may make changes to the budget within state category. ", "", "Accounts are grouped according to their purpose under 5 major types of expenditures - Salaries and Wages which includes position salaries and other (temporary part time) salaries, Contractual Services, Supplies and Materials, Other Expenses, and Equipment.", "A full-time equivalent position, or FTE, corresponds to the number of hours a budgeted position is scheduled to work.  A 1.0 FTE works full time, or 40 hours per week.", "", "In December, the Superintendent of Schools presents his Recommended Fiscal Year Operating Budget to the Board of Education. "], "columns_format": [{"precisionStyle": "standard", "noCommas": "false", "precision": "3", "align": "right"}, {"precisionStyle": "currency", "currencyStyle": "USD", "precision": "2"}, {}, {"align": "left"}, {"align": "left"}, {"align": "left"}, {"align": "left"}, {"precision": "2", "align": "right", "currencyStyle": "USD", "humane": "false", "precisionStyle": "currency"}, {"precisionStyle": "standard", "noCommas": "false", "precision": "3", "align": "right"}, {"align": "left"}, {"precisionStyle": "standard", "noCommas": "false", "precision": "3", "align": "right"}, {}, {"precision": "2", "align": "right", "currencyStyle": "USD", "humane": "false", "precisionStyle": "currency"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2015-07-07T14:14:32.000Z"}, "classification": {"categories": ["finance", "environment", "economy"], "tags": [], "domain_category": "Budget", "domain_tags": [], "domain_metadata": []}, "metadata": {"domain": "data.montgomeryschoolsmd.org"}, "permalink": "https://data.montgomeryschoolsmd.org/d/u7b4-7dy2", "link": "https://data.montgomeryschoolsmd.org/Budget/FY2016-MCPS-Operating-Budget/u7b4-7dy2", "owner": {"id": "36y8-4umn", "user_type": "interactive", "display_name": "Rafael Gramatges"}, "creator": {"id": "36y8-4umn", "user_type": "interactive", "display_name": "Rafael Gramatges"}}
