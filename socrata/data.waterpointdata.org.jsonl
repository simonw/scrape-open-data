{"resource": {"name": "Water Point Data Exchange (WPdx-Basic)", "id": "jfkt-jmqa", "resource_name": null, "parent_fxf": [], "description": "The Water Point Data Exchange (WPdx) is the global platform for sharing water point data. The WPdx Data Standard was designed by a wide range of stakeholders from across sectors and around the world. The core attributes included in the standard are already being collected by governments, researchers, and organizations around the world. To read more about the standard or to contribute water point data visit www.waterpointdata.org.", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2025-02-05T07:18:55.000Z", "createdAt": "2020-09-23T17:30:06.000Z", "metadata_updated_at": "2025-02-05T07:10:16.000Z", "data_updated_at": "2025-02-05T07:18:55.000Z", "columns_name": ["Countries", "updated", "created_timestamp", "public_data_source", "#converted", "lat_lon_deg", "#adm1", "#adm2", "#adm3", "clean_adm3", "clean_adm4", "New Georeferenced Column", "count", "status_clean", "management_clean", "facility_type", "water_tech_category", "water_tech_clean", "water_source_category", "water_source_clean", "#installer", "#install_year", "#pay", "#status", "#fecal_coliform_value", "#fecal_coliform_presence", "#subjective_quality", "#subjective_quality_clean", "#pay_clean", "dataset_title", "clean_country_id", "clean_country_name", "clean_adm1", "clean_adm2", "#activity_id", "#scheme_id", "#notes", "#photo_lnk", "#orig_lnk", "#data_lnk", "#management", "#country_id", "#rehabilitator", "#rehab_year", "row_id", "#source", "#lat_deg", "#lon_deg", "#report_date", "#status_id", "#water_source", "#water_tech", "#country_name"], "columns_field_name": [":@computed_region_7zzf_xi3x", "updated", "created_timestamp", "public_data_source", "converted", "lat_lon_deg", "adm1", "adm2", "_adm3", "clean_adm3", "clean_adm4", "geocoded_column", "count", "status_clean", "management_clean", "_facility_type", "water_tech_