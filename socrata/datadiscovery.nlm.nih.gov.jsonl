{"resource": {"name": "MeSH 2023 - New Headings with Scope Notes", "id": "aqtu-bnvm", "resource_name": null, "parent_fxf": [], "description": "This dataset includes all newly added MeSH Main Headings for 2023. Headings play a central role in MeSH vocabulary as a unit of Indexing and retrieval. With the exception of Class 3 Descriptors, all descriptors are organized into a numbered tree structure or hierarchy that allows users to browse in a orderly fashion from broader to narrower topics.  Scope Notes provide a concise summary describing the meaning and scope of the MeSH Descriptor.", "attribution": null, "attribution_link": null, "contact_email": "custserv@nlm.nih.gov", "type": "dataset", "updatedAt": "2024-09-03T19:14:42.000Z", "createdAt": "2022-12-19T22:03:41.000Z", "metadata_updated_at": "2024-09-03T19:14:42.000Z", "data_updated_at": "2022-12-19T22:06:21.000Z", "columns_name": ["Scope Note", "Tree Category", "Mn", "MeSH Heading"], "columns_field_name": ["scope_note", "tree_category", "mn", "mesh_heading"], "columns_datatype": ["Text", "Text", "Text", "Text"], "columns_description": ["", "", "", ""], "columns_format": [{}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-12-19T22:06:26.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Terminology", "domain_tags": ["mesh", "mesh 2023 update"], "domain_metadata": [{"key": "Common-Core_Contact-Email", "value": "custserv@nlm.nih.gov"}, {"key": "Common-Core_Program-Code", "value": "009:041"}, {"key": "Common-Core_NLM-Organization", "value": "User Services and Collection Division (USCD)"}, {"key": "Common-Core_NLM-Products-and-Services", "value": "No"}, {"key": "Common-Core_Homepage", "value": "https://www.nlm.nih.gov/mesh/meshhome.html"}, {"key": "Common-Core_Bureau-Code", "value": "009:25"}, {"key": "Common-Core_Contact-Name", "value": "National 