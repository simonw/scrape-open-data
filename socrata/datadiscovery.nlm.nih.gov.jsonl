{"resource": {"name": "MEDLINE/PubMed Baseline Statistics: Min/Max Report", "id": "xtvu-8j6w", "resource_name": null, "parent_fxf": [], "description": "*A file containing all Min/Max Baseline Reports for 2005-2023 in their original format is available in the <b>Attachments</b> section below. A second file includes a separate set of reports, made available from 2002-2017, that did not include OLDMEDLINE records.* \n\nMEDLINE/PubMed annual statistical reports are based upon the data elements in the baseline versions of MEDLINE\u00ae/PubMed are available. For each year covered the reports include: total citations containing each element; total occurrences of each element; minimum/average/maximum occurrences of each element in a record; minimum/average/maximum length of a single element occurrence; average record size; and other statistical data describing the content and size of the elements.", "attribution": null, "attribution_link": null, "contact_email": "custserv@nlm.nih.gov", "type": "dataset", "updatedAt": "2024-09-06T18:01:31.000Z", "createdAt": "2023-03-21T17:13:13.000Z", "metadata_updated_at": "2024-09-06T18:01:31.000Z", "data_updated_at": "2023-03-22T13:11:33.000Z", "columns_name": ["Max Len", "Min Len", "Max Occurs", "Avg Occurs", "Occurrences", "Citations", "Element Name", "Min Occurs", "Avg Len"], "columns_field_name": ["max_len", "min_len", "max_occurs", "avg_occurs", "occurrences", "citations", "element_name", "min_occurs", "avg_len"], "columns_datatype": ["Number", "Number", "Number", "Number", "Number", "Number", "Text", "Number", "Number"], "columns_description": ["", "", "", "", "", "", "", "", ""], "columns_format": [{"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2023-03-21T17:21:18.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Literature", "domain_tags": ["pubmed"], "domain_metadata": [{"key": "Common-Core_Contact-Email", "value": "custserv@nlm.nih.gov"}, {"key": "Common-Core_Program-Code", "value": "009:041"}, {"key": "Common-Core_NLM-Organization", "value": "Lister Hill National Center for Biomedical Communications (LHNCBC)"}, {"key": "Common-Core_NLM-Products-and-Services", "value": "No"}, {"key": "Common-Core_Bureau-Code", "value": "009:25"}, {"key": "Common-Core_Contact-Name", "value": "National Library of Medicine"}]}, "metadata": {"domain": "datadiscovery.nlm.nih.gov"}, "permalink": "https://datadiscovery.nlm.nih.gov/d/xtvu-8j6w", "link": "https://datadiscovery.nlm.nih.gov/Literature/MEDLINE-PubMed-Baseline-Statistics-Min-Max-Report/xtvu-8j6w", "owner": {"id": "8vej-juw8", "user_type": "interactive", "display_name": "National Library of Medicine"}, "creator": {"id": "8vej-juw8", "user_type": "interactive", "display_name": "National Library of Medicine"}}
