{"resource": {"name": "MeSH 2023 Publication Types", "id": "vwzh-6q7y", "resource_name": null, "parent_fxf": [], "description": "Publication Types (Publication Characteristics) are Descriptors that indicate what an indexed item is, (i.e., its genre, rather than what it is about - for example, Historical Article). They may include Publication Components, such as Charts; Publication Formats, such as Editorial; and Study Characteristics, such as Clinical Trial.\n\nThey function as metadata, rather than being about the content. These records are searchable in PubMed as Publication Type [PT], and the terms in MEDLINE records are labeled as \"PT\" or <PublicationType> rather than \"MH\" or <MeSHHeading>. They are listed in category V of the MeSH Tree Structures.", "attribution": null, "attribution_link": null, "contact_email": "custserv@nlm.nih.gov", "type": "dataset", "updatedAt": "2024-09-03T19:14:23.000Z", "createdAt": "2022-12-19T21:56:40.000Z", "metadata_updated_at": "2024-09-03T19:14:23.000Z", "data_updated_at": "2022-12-19T22:02:54.000Z", "columns_name": ["Year", "Publication Type Heading"], "columns_field_name": ["year", "pub_type_heading"], "columns_datatype": ["Number", "Text"], "columns_description": ["", ""], "columns_format": [{"decimalSeparator": ".", "noCommas": "true", "groupSeparator": ",", "align": "right"}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-12-19T22:03:00.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Terminology", "domain_tags": ["mesh", "mesh 2023 update"], "domain_metadata": [{"key": "Common-Core_Contact-Email", "value": "custserv@nlm.nih.gov"}, {"key": "Common-Core_Program-Code", "value": "009:041"}, {"key": "Common-Core_NLM-Organization", "value": "User Services and Collection Division (USCD)"}, {"key": "Common-Core_NLM-Products-and-Services", "value": "No"}, {"key": "