{"resource": {"name": "MeSH 2025 Update - Registry Number Update Report", "id": "vtwh-v35w", "resource_name": null, "parent_fxf": [], "description": "<b>(Includes MeSH 2023 and 2024 changes)</b>  The MeSH 2025 Update - Registry Number Update Report lists changes to Registry Numbers on a Descriptor or Supplementary Concept Record (SCR).  <b>This report includes MeSH changes from previous years, starting from 2023.</b>", "attribution": null, "attribution_link": null, "contact_email": "custserv@nlm.nih.gov", "type": "dataset", "updatedAt": "2024-12-16T18:54:52.000Z", "createdAt": "2022-11-08T15:21:12.000Z", "metadata_updated_at": "2024-12-16T18:54:51.000Z", "data_updated_at": "2024-12-16T18:54:52.000Z", "columns_name": ["UI", "Year", "NOTES", "REPLACEMENT_VALUE", "REPLACED_VALUE", "UPDATED_FIELD"], "columns_field_name": ["ui", "year", "notes", "replacement_value", "replaced_value", "updated_field"], "columns_datatype": ["Text", "Text", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2023-12-14T20:10:28.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Terminology", "domain_tags": ["api", "mesh", "mesh 2023 update", "mesh 2024 update", "mesh 2025 update", "terminologies"], "domain_metadata": [{"key": "Common-Core_Contact-Email", "value": "custserv@nlm.nih.gov"}, {"key": "Common-Core_Program-Code", "value": "009:041"}, {"key": "Common-Core_NLM-Organization", "value": "User Services and Collection Division (USCD)"}, {"key": "Common-Core_Bureau-Code", "value": "009:25"}, {"key": "Common-Core_Contact-Name", "value": "National Library of Medicine"}]}, "metadata": {"domain": "datadiscovery.nlm.nih.gov"}, "permalink": "https://datadiscovery.nlm.nih.gov/d/vtwh-v35w", "link": "https://datadiscovery.nlm