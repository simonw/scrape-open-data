{"resource": {"name": "NOAA - Annual number of sites characterized in the U.S. Exclusive Economic Zone", "id": "yvkm-zdrk", "parent_fxf": [], "description": "Proposed new indicator for FY 2019. \n\nThis measure tracks the annual number of sites whose oceanographic, archaeological, or cultural resource properties have been characterized to enable efficient, sustainable use of the nation\u2019s undersea resources. Characterizations are performed by ROV dive with video and/or photographic analysis and physical, biological, geological, or chemical sampling; by photogrammetric survey and environmental sample collection by autonomous underwater vehicles (AUVs); or through similar advanced technological techniques.", "attribution": "National Oceanic and Atmospheric Administration", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-07-19T20:54:43.000Z", "createdAt": "2019-05-06T19:28:18.000Z", "metadata_updated_at": "2022-07-19T20:54:43.000Z", "data_updated_at": "2021-11-12T19:30:04.000Z", "columns_name": ["Actual", "Fiscal Year", "Target", "Status", "Performance Indicator"], "columns_field_name": ["actual", "fiscal_year", "target", "status", "performance_indicator"], "columns_datatype": ["Number", "Calendar date", "Number", "Text", "Text"], "columns_description": ["", "", "", "", ""], "columns_format": [{}, {"view": "date"}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2019-05-07T20:22:02.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "KPI: NOAA", "domain_tags": ["agriculture", "climate change", "commerce & trade", "economic development", "economic security & policy", "equity", "pandemic response", "pma - business of government"], "domain_metadata": [{"key": "Affirmation_I-affirm-that,-to-the-best-of-my-knowledge,-this-data-is-accurate-and-does-not-contain-any-personally-identifiabl