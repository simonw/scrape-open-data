{"resource": {"name": "EDA - Jobs created/retained - 9 year totals.", "id": "yvkc-snmr", "parent_fxf": [], "description": "The formula-driven calculation projects investment data at 3, 6, and 9 year intervals from the investment award. The formula is based on a study done by Rutgers University, which compiled and analyzed the performance of EDA construction investments after 9 years. This approach was reviewed and validated by third-party analysis conducted by Grant Thornton in 2008. Based on this formula and a review of EDA's historical results, EDA estimates that 40% of the 9-year projection would be realized after 3 years, 75% after 6 years, and 100% after 9 years.", "attribution": "Economic Development Administration", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-07-19T20:54:33.000Z", "createdAt": "2019-03-20T17:21:51.000Z", "metadata_updated_at": "2022-07-19T20:54:33.000Z", "data_updated_at": "2021-11-10T21:30:58.000Z", "columns_name": ["Actual", "Fiscal Year", "Indicator", "Target", "Status", "Proximity"], "columns_field_name": ["actual", "fiscal_year", "indicator", "target", "status", "proximity"], "columns_datatype": ["Number", "Calendar date", "Text", "Number", "Text", "Number"], "columns_description": ["", "", "", "", "", ""], "columns_format": [{}, {"view": "date"}, {}, {}, {}, {"precisionStyle": "percentage", "percentScale": "1"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2021-11-10T21:31:04.000Z"}, "classification": {"categories": ["finance"], "tags": [], "domain_category": "KPI: EDA", "domain_tags": ["agriculture", "climate change", "commerce & trade", "economic development", "economic security & policy", "equity", "pandemic response", "pma - business of government"], "domain_metadata": [{"key": "Affirmation_I-affirm-that,-to-the-best-of-my-knowledge,-this-data-is-accurate-and-does-not-contain-