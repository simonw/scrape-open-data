{"resource": {"name": "BIS - Number of end-use checks completed", "id": "sse7-k9fm", "parent_fxf": [], "description": "A key element of BIS\u2019s policy formulation and implementation toward other key countries is conducting EUCs to verify that targeted dual-use exports and munitions items transferred from the USML to the CCL will be or have been properly used by the proper end-users. End-use checks are comprised of both Pre-license Checks (PLCs) and PSVs. PLCs are used to determine if an overseas person or firm is a suitable party to a transaction involving controlled U.S. origin items. A PSV confirms whether or not goods exported from the U.S. actually were received by the party named on the license or other export documentation, and whether the goods are being used in accordance with the provisions of that license.", "attribution": "Bureau of Industry and Security", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-07-19T20:53:52.000Z", "createdAt": "2019-03-18T16:35:28.000Z", "metadata_updated_at": "2022-07-19T20:53:52.000Z", "data_updated_at": "2021-11-26T20:07:35.000Z", "columns_name": ["Fiscal Year", "Target", "Status", "Indicator", "Actual", "Proximity"], "columns_field_name": ["fiscal_year", "target", "status", "indicator", "actual", "proximity"], "columns_datatype": ["Calendar date", "Number", "Text", "Text", "Number", "Number"], "columns_description": ["", "", "", "", "", ""], "columns_format": [{"view": "date"}, {"precision": "0"}, {}, {}, {}, {"precisionStyle": "percentage", "percentScale": "1", "align": "left"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2021-11-26T20:07:41.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "KPI: BIS", "domain_tags": ["administration of justice", "commerce & trade", "economic development", "economic security & policy", "international affairs