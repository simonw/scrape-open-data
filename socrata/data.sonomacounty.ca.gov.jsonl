{"resource": {"name": "Sonoma County Sheriff's Office Event Data", "id": "bpq8-s7gr", "parent_fxf": [], "description": "Event data summarizes Sheriff's dispatch and deputy initiated activities. Events related to the following Penal Codes have been omitted in accordance with the California Public Records Act: 220, 236.1, 243.4, 261, 261.5, 262, 262(a)(1), 264, 264.1, 265, 266, 266(a), 266(b), 266(c), 266(e), 266(f), 266(j), 267, 269, 269(a), 273(a), 273(d), 273.5, 285, 286, 288, 288(a), 288.2, 288.3, 288.5, 288.7, 289, 422.6, 422.7, 422.75, 646.9, 647.6, as well as Welfare and Institutions Code 5150 or Business and Professions Code 729(a) and Stake Out. Additionally canceled events are not reported.", "attribution": "Sonoma County Sheriff's Office", "attribution_link": "http://www.sonomasheriff.org", "contact_email": null, "type": "dataset", "updatedAt": "2022-09-11T08:29:50.000Z", "createdAt": "2015-05-13T22:37:46.000Z", "metadata_updated_at": "2015-06-03T08:49:36.000Z", "data_updated_at": "2022-09-11T08:29:50.000Z", "columns_name": ["nature description", "address", "location", "location (address)", "location (city)", "agency", "id", "date time", "event number", "beat-zone", "disposition code", "Zip Codes", "Census Tract Boundary", "agency name", "disposition", "nature code", "incident number", "event source", "location (state)", "location (zip)"], "columns_field_name": ["nature_description", "address", "location", "location_address", "location_city", "agency", "id", "date_time", "event_num", "beat_zone", "disposition_code", ":@computed_region_dig5_f3vy", ":@computed_region_xw9s_pz78", "agency_name", "disposition", "nature_code", "incident_num", "event_source", "location_state", "location_zip"], "columns_datatype": ["Text", "Text", "Point", "Text", "Text", "Text", "Number", "Calendar date", "Text", "Text", "Text", "Number", "Number", "Text", "Text", "Text", "Text", "Text", "Text", "Text"], "columns_description": ["Nature of the event that was reported to dispatch.",