{"resource": {"name": "Water Wise House Calls", "id": "9arj-6hzg", "parent_fxf": [], "description": "A Water Wise House Call is a program where the City of Roseville\u2019s Water Efficiency technicians analyze your water use and provide you with water savings tips and devices free of charge. The program consist of the following: \u2022 Check toilets and other plumbing fixtures for leaks. \u2022 Help develop proper and efficient water irrigation schedules. \u2022 Provide free water-saving devices, brochures and any current rebate information to help reduce water use. \u2022 Assess irrigation sprinkler uniformity and water runoff characteristics. \u2022 Analyze irrigation and drainage systems and provide maintenance, repair or replacement recommendations. \u2022 Check meter reading and water pressure (if relevant). \u2022 Pressure check exterior plumbing for leaks. Schedule your appointment today by calling (916) 774-5761", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-09-26T22:11:39.000Z", "createdAt": "2022-03-22T22:59:14.000Z", "metadata_updated_at": "2022-09-26T22:11:39.000Z", "data_updated_at": "2022-03-22T23:06:57.000Z", "columns_name": ["Water Wise House Calls", "Year"], "columns_field_name": ["water_wise_house_calls", "year"], "columns_datatype": ["Number", "Calendar date"], "columns_description": ["", ""], "columns_format": [{}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-03-22T23:00:36.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Environmental Utilities", "domain_tags": ["water conservation", "water efficiency", "water usage"], "domain_metadata": []}, "metadata": {"domain": "data.roseville.ca.us"}, "permalink": "https://data.roseville.ca.us/d/9arj-6hzg", "link": "https://data.roseville.ca.us/Environmental-Utilities/Water-Wise-House-Calls/9arj-6hzg", "owner": {"id": "waf3-c7ac", "user_type": "interactive", "display_name": "Nanise Tomlinson"}, "creator": {"id": "waf3-c7ac", "user_type": "interactive", "display_name": "Nanise Tomlinson"}}
