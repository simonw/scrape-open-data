{"resource": {"name": "State of Vermont Employee Salaries", "id": "jgqy-2smf", "parent_fxf": [], "description": "Salary information for State of Vermont active employees from all branches. Generally, employees who are expected to work year-round have salaries stated as salary type \"Annual.\" Temporary employees have salaries stated as salary type \"Hourly.\"  Legislators, who usually do not work year-round, have salaries stated as salary type \"Weekly.\" The weekly rate reported here is the rate paid during the legislative session. Data as of the last Friday of each month. NOTE: Individuals covered by the Safe at Home Act (Title 15 Sections 1150-1160) have been excluded from this list.", "attribution": "Department of Human Resources", "attribution_link": "http://humanresources.vermont.gov", "contact_email": null, "type": "dataset", "updatedAt": "2022-07-29T14:32:34.000Z", "createdAt": "2017-03-16T14:47:57.000Z", "metadata_updated_at": "2022-07-29T14:32:30.000Z", "data_updated_at": "2022-07-29T14:32:34.000Z", "columns_name": ["Salary", "Data as of", "Name", "Job Type", "Department", "Salary Type", "Job Title"], "columns_field_name": ["salary", "data_as_of", "name", "reg_temp", "department", "salary_type", "job_title"], "columns_datatype": ["Number", "Calendar date", "Text", "Text", "Text", "Text", "Text"], "columns_description": ["", "", "", "Classified, Exempt, General Assembly, Temporary, or Contractual", "", "", ""], "columns_format": [{"noCommas": "false", "precision": "2", "align": "right", "currencyStyle": "USD", "precisionStyle": "standard"}, {"view": "date", "align": "left"}, {}, {"displayStyle": "plain", "align": "left"}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2018-07-27T18:48:48.000Z"}, "classification": {"categories": ["finance", "politics", "economy"], "tags": [], "domain_category": "Government", "domain_tags": ["compensation", "employee", "pay", "salary", "vermont"], "domain_metadata": []}, "metadata": {"domain": "data.vermont.gov"}, "permalink": "https://data.vermont.gov/d/jgqy-2smf", "link": "https://data.vermont.gov/Government/State-of-Vermont-Employee-Salaries/jgqy-2smf", "owner": {"id": "92fu-z7va", "user_type": "interactive", "display_name": "Jaron Foster"}, "creator": {"id": "92fu-z7va", "user_type": "interactive", "display_name": "Jaron Foster"}}
