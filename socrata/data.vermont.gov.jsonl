{"resource": {"name": "State of Vermont Employee Salaries", "id": "jgqy-2smf", "parent_fxf": [], "description": "Salary information for State of Vermont active employees from all branches. Generally, employees who are expected to work year-round have salaries stated as salary type \"Annual.\" Temporary employees have salaries stated as salary type \"Hourly.\"  Legislators, who usually do not work year-round, have salaries stated as salary type \"Weekly.\" The weekly rate reported here is the rate paid during the legislative session. Data as of the last Friday of each month. NOTE: Individuals covered by the Safe at Home Act (Title 15 Sections 1150-1160) have been excluded from this list.", "attribution": "Department of Human Resources", "attribution_link": "http://humanresources.vermont.gov", "contact_email": null, "type": "dataset", "updatedAt": "2024-07-26T17:20:42.000Z", "createdAt": "2017-03-16T14:47:57.000Z", "metadata_updated_at": "2024-07-26T17:19:45.000Z", "data_updated_at": "2024-07-26T17:20:42.000Z", "columns_name": ["Job Title", "Salary", "Department", "Salary Type", "Data as of", "Name", "Job Type"], "columns_field_name": ["job_title", "salary", "department", "salary_type", "data_as_of", "name", "reg_temp"], "columns_datatype": ["Text", "Number", "Text", "Text", "Calendar date", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "Classified, Exempt, General Assembly, Temporary, or Contractual"], "columns_format": [{}, {"noCommas": "false", "precision": "2", "align": "right", "currencyStyle": "USD", "precisionStyle": "standard"}, {}, {}, {"view": "date", "align": "left"}, {}, {"displayStyle": "plain", "align": "left"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2018-07-27T18:48:48.000Z"}, "classification": {"categories": ["finance", "politics", "economy"], "tags": [], "domain_category": "Government", "domain_t