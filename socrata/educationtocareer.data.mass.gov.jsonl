{"resource": {"name": "Educator Preparation Candidate Enrollment and Program Completion by Race/Ethnicity", "id": "t375-4q57", "resource_name": null, "parent_fxf": [], "description": "This dataset displays educator preparation data by race and ethnicity with rows for different years. It was created as part of a dashboard supporting the Massachusetts Department of Elementary and Secondary Education's commitment to provide all students with a racially diverse and culturally responsive educator workforce.<BR>\n<B>Educator Preparation</B>: This displays the number and percent of candidates who enrolled and completed their program in the program year. This is based on the individuals' furthest, or most recently reported, point in the selected program year as reported by the organization.<BR>\nThis dataset contains the same data that is also published in the Educator Preparation table on our <a href=\"https://app.powerbigov.us/view?r=eyJrIjoiNGQ2NmM5ZGItZjgyNS00ZjEyLWEyYmMtZDBkZGQxMWJiMTFlIiwidCI6IjNlODYxZDE2LTQ4YjctNGEwZS05ODA2LThjMDRkODFiN2IyYSJ9\"target=\"_blank\" rel=\"noopener noreferrer\">Educator Dashboard</a>.", "attribution": "Department of Elementary and Secondary Education", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-07-26T15:46:31.000Z", "createdAt": "2023-09-20T22:42:20.000Z", "metadata_updated_at": "2024-07-26T15:46:31.000Z", "data_updated_at": "2023-09-26T00:43:51.000Z", "columns_name": ["IND_PCT", "SY", "IND_CNT", "RACE_ETH", "IND"], "columns_field_name": ["ind_pct", "sy", "ind_cnt", "race_eth", "ind"], "columns_datatype": ["Number", "Text", "Number", "Text", "Text"], "columns_description": ["Indicator Percent", "School Year", "Indicator Count", "Race and Ethnicity", "Indicator"], "columns_format": [{"precisionStyle": "percentage", "percentScale": "1", "decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2023-09-26T19:43:22.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Students and Teachers", "domain_tags": ["accountability", "administrators", "demographic", "ed prep", "educator data dashboard", "educator pipeline", "educator preparation", "educators", "employment", "ethnicity", "full-time employment", "paraprofessionals", "race"], "domain_metadata": []}, "metadata": {"domain": "educationtocareer.data.mass.gov"}, "permalink": "https://educationtocareer.data.mass.gov/d/t375-4q57", "link": "https://educationtocareer.data.mass.gov/Students-and-Teachers/Educator-Preparation-Candidate-Enrollment-and-Prog/t375-4q57", "owner": {"id": "m5tk-n3hd", "user_type": "interactive", "display_name": "E2C Hub"}, "creator": {"id": "m5tk-n3hd", "user_type": "interactive", "display_name": "E2C Hub"}}
{"resource": {"name": "Enrollment: Grade, Race/Ethnicity, Gender, and Selected Populations", "id": "t8td-gens", "resource_name": null, "parent_fxf": [], "description": "This dataset contains student enrollment data for all Massachusetts public schools and districts since 1994. It is a wide file with three groups of columns representing the following enrollment indicators:<ul><li>Number of students by grade, including pre-kindergarten (PK), kindergarten (K) and special education beyond grade 12 (SP)</li><li>Percent of students by race and gender</li><li>Number and percent of students in student groups: First Language Not English, English Learners, Students with Disabilities, High Needs, Low Income, and Economically Disadvantaged</li></ul>Economically Disadvantaged was used 2015-2021. Low Income was used prior to 2015, and a different version of Low Income has been used since 2022. Please see the <a href=\"https://www.doe.mass.edu/research/researchers.html\" target=\"_blank\" rel=\"noopener noreferrer\">DESE Researcher's Guide</a> for more information.\n\nThis dataset contains the same data that is also published on our DESE Profiles site:\n<a href=\"https://profiles.doe.mass.edu/statereport/enrollmentbygrade.aspx\" target=\"_blank\" rel=\"noreferrer noopener\">Enrollment by Grade</a>\n<a href =\"https://profiles.doe.mass.edu/statereport/enrollmentbyracegender.aspx\" target=\"_blank\" rel=\"noreferrer noopener\">Enrollment by Race/Gender</a>\n<a href=\"https://profiles.doe.mass.edu/statereport/selectedpopulations.aspx\" target=\"_blank\" rel=\"noreferrer noopener\">Enrollment by Selected Population</a>", "attribution": "Department of Elementary and Secondary Education", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-09-27T19:59:38.000Z", "createdAt": "2023-03-31T22:12:34.000Z", "metadata_updated_at": "2024-09-27T19:58:48.000Z", "data_updated_at": "2024-09-27T19:59:38.000Z", "columns_name": ["DIST_CODE", "G3_CNT", "G9_CNT", "EL_C