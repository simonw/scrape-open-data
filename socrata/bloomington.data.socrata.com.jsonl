{"resource": {"name": "GIS Map Panel Boundaries", "id": "ymp5-yvgv", "parent_fxf": [], "description": "<DIV STYLE=\"text-align:Left;\"><P STYLE=\"margin:0 0 0 0;\"><SPAN><SPAN>This map data layer represents the GIS Map Panel Boundaries for the City of Bloomington, Indiana. The GIS Map Panel Boundaries data layer was created as a reference grid for the GIS map data. The grid tiles are 3000' by 2000' and cover a total of 86.3 square miles of central Monroe County in Indiana. The panel tiles are located arbitrary to any geographic features</SPAN></SPAN></P><DIV><P><SPAN /></P></DIV></DIV>", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-12-30T16:17:36.000Z", "createdAt": "2022-08-11T20:54:28.000Z", "metadata_updated_at": "2022-12-30T16:17:36.000Z", "data_updated_at": "2022-08-11T20:54:32.000Z", "columns_name": ["st_length(shape)", "MAP_AREA", "the_geom", "st_area(shape)", "MAP_PANEL", "objectid", "GROUP_200", "MAP_PAGE", "GROUP_400"], "columns_field_name": ["st_length_shape", "map_area", "the_geom", "st_area_shape", "map_panel", "objectid", "tile_group_200", "map_page", "tile_group_400"], "columns_datatype": ["Number", "Text", "MultiPolygon", "Number", "Text", "Number", "Text", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-08-11T20:54:29.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Maps", "domain_tags": ["gis"], "domain_metadata": []}, "metadata": {"domain": "bloomington.data.socrata.com", "license": "Open Data Commons Public Domain Dedication and License"}, "permalink": "https://bloomington.data.socrata.com/d/ymp5-yvgv", "link": "https://bloomington.data.socrata.com/Maps/GIS-Map-Panel-Boundaries/ymp5-yvgv", "owner": {"id": "mejs