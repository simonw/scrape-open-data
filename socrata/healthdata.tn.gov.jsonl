{"resource": {"name": "Annual Mean Concentration of Haloacetic Acids (HAA5) in Drinking Water, 2022", "id": "jwxu-keuc", "parent_fxf": [], "description": "This dataset describes the annual mean concentration of the contaminant, haloacetic acids (HAA5), in community water systems across Tennessee in 2022.", "attribution": "Tennessee Department of Environment and Conservation (TDEC)", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-08-09T21:19:29.000Z", "createdAt": "2023-12-19T18:12:14.000Z", "metadata_updated_at": "2024-08-09T21:19:29.000Z", "data_updated_at": "2024-08-09T20:20:11.000Z", "columns_name": ["Population Served", "MCL Category", "Average Concentration", "County", "Year", "Row Identifier", "County FIPS", "PWS ID"], "columns_field_name": ["population_served", "mcl_category", "average_concentration", "county", "year", "row_identifier", "county_fips", "pws_id"], "columns_datatype": ["Number", "Number", "Number", "Text", "Number", "Number", "Number", "Text"], "columns_description": ["Number of people drinking water is supplied to, in a county", "Maximum contaminant level category (1=Greater than MCL, 2=Less than or equal to MCL, 3=Not detected)", "Average concentration level of analyte observed in county's drinking water, measured in micrograms per liter (ug/L)", "Name of county", "Year of analysis", "Number assigned to line of data for identification purposes", "County FIPS code assigned by the U.S. Census Bureau to identify counties", "Identification number assigned to public water system (PWS)"], "columns_format": [{"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {}, {"decimalSeparator": ".", "noCommas": "true", "groupSeparator": ","}, {"decimalSeparator": ".", "noCommas": "true", "groupSeparator": ","}, {"decimalSeparator": ".", "noCommas": "true", "groupSeparator": ","}, {}], "provenance": "official", "lens_view_type