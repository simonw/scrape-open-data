{"resource": {"name": "Annual Mean Concentration of Arsenic in Drinking Water, 2022", "id": "wnta-ve97", "parent_fxf": [], "description": "This dataset describes the annual mean concentration of the contaminant, arsenic, in community water systems across Tennessee in 2022.", "attribution": "Tennessee Department of Environment and Conservation (TDEC)", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-08-09T21:20:52.000Z", "createdAt": "2023-12-19T16:57:38.000Z", "metadata_updated_at": "2024-08-09T21:20:52.000Z", "data_updated_at": "2024-08-09T19:59:09.000Z", "columns_name": ["Year", "County", "PWS ID", "MCL Category ID", "Row Identifier", "Population Served", "Average Concentration", "County FIPS"], "columns_field_name": ["year", "county", "pws_id", "mcl_category_id", "row_identifier", "population_served", "average_concentration", "county_fips"], "columns_datatype": ["Number", "Text", "Text", "Number", "Number", "Number", "Number", "Number"], "columns_description": ["Year of analysis", "Name of county", "Identification number assigned to public water system (PWS)", "Maximum contaminant level category (1=Greater than MCL, 2=Less than or equal to MCL, 3=Not detected)", "Number assigned to line of data for identification purposes", "Number of people drinking water is supplied to, in a county", "Average concentration level of analyte observed in county's drinking water, measured in micrograms per liter (ug/L)", "County FIPS code assigned by the U.S. Census Bureau to identify counties"], "columns_format": [{"decimalSeparator": ".", "noCommas": "true", "groupSeparator": ","}, {}, {}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "noCommas": "true", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "groupSeparator": ","}, {"decimalSeparator": ".", "noCommas": "true"}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "lock