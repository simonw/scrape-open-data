{"resource": {"name": "Bacteria Sample Data", "id": "e49x-tw9b", "resource_name": null, "parent_fxf": [], "description": "Samples are taken daily at locations throughout the distribution system. Temperature, pH, and Total Chlorine Residual are collected by city personnel. Samples are taken to a lab to be analyzed for Total Coliform and E. Coli indicators. Results are returned to the city the following business day.", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-10-10T10:33:25.000Z", "createdAt": "2018-10-31T19:18:11.000Z", "metadata_updated_at": "2024-10-10T10:33:21.000Z", "data_updated_at": "2024-10-10T10:33:25.000Z", "columns_name": ["Replacement Address/Notes", "SITE #", "RESULTS", "Number of Samples Taken", "Sample Type", "DATE", "Street", "Free Chlorine", "Total Chlorine Residual"], "columns_field_name": ["replacement_address_or_notes", "site", "results", "number_of_samples_taken", "replacement_sample", "date", "street", "free_chlorine", "total_chlorine_residual"], "columns_datatype": ["Text", "Text", "Text", "Number", "Text", "Calendar date", "Text", "Number", "Number"], "columns_description": ["Indicates the location of replacement samples, special samples, or any notes associated with the sample.", "Unique identifier for the bacteria sample site.", "Provides results from the laboratory to indicate pass, fail, or if sample was rejected.", "Number of samples taken at the location.", "Bacteria Samples are routine and collected every 30 days. If a sample has an error, is rejected, or has bacteria present, a replacement sample is taken. This column indicates if the sample is a replacement. Special Samples are locations that are not normally sampled. Refer to the notes section to determine why sample was taken.", "Date test was conducted.", "Street name for where water sample was collected.", "The amount of free chlorine as measured in mg/L. This number increases in Feb/Mar during the chlorine maintenance period. Instruments have an accuracy of plus or minus 0.1 mg/L.", "The level of chlorine disinfectant by measuring chloramines (minimum requirement is .5 mg/L). Instruments have an accuracy of plus or minus 0.1 mg/L."], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2019-10-10T18:42:03.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Public Works", "domain_tags": ["bacteria", "*s drive", "water quality"], "domain_metadata": []}, "metadata": {"domain": "dashboard.plano.gov"}, "permalink": "https://dashboard.plano.gov/d/e49x-tw9b", "link": "https://dashboard.plano.gov/Public-Works/Bacteria-Sample-Data/e49x-tw9b", "owner": {"id": "gxds-w39h", "user_type": "interactive", "display_name": "Rod"}, "creator": {"id": "gxds-w39h", "user_type": "interactive", "display_name": "Rod"}}
