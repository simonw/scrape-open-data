{"resource": {"name": "Parks and Recreation Attendance Data", "id": "n5tf-z5jy", "resource_name": null, "parent_fxf": [], "description": "This data set contains information on the Parks and Recreation attendance. The letters contained within parentheses in the top row denote more information about where the data comes from. From left to right, the parentheses stand for the following: (T) - Total, (AQ) - Aquatics Program, (ADATH) - Adult Athletics, (CAR) Carpenter Park Recreation Center, (LIB) - Liberty Recreation Center, (OAK) - Oak Point Center, (OUT) - Outdoor Program, (SEN) - Senior Center, (TR) - Therapeutic Recreation, (TOM) - The Tom Muehlenbeck Center", "attribution": "The City of Plano Department of Parks and Recreation", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-10-01T08:15:05.000Z", "createdAt": "2015-11-24T16:28:50.000Z", "metadata_updated_at": "2024-10-01T08:15:04.000Z", "data_updated_at": "2024-10-01T08:15:05.000Z", "columns_name": ["(T) Adult Athletics", "(T) Adapted Recreation", "(T) Center Attendance", "(T) Program Attendance", "(T) Liberty", "(T) Aquatics Jack Carter", "(T) Nature Retreat Center", "(T) Oak Point", "(T) Golf", "(T) Tennis", "(T) Tom Muehlenbeck", "(T) Aquatics PAC/NAT", "(T) Carpenter", "(T) Senior Center", "(T) Aerobats", "Date", "(T) Arts & Events"], "columns_field_name": ["t_adult_athletics", "t_therapeutic_rec", "t_center_attendance", "_t_program_attendance", "t_liberty", "_t_aquatics_jack_carter", "t_outdoor", "t_oak_point", "t_golf", "t_tennis", "t_tom_muehlenbeck", "t_aquatics", "t_carpenter", "t_senior_center", "t_aerobats", "date", "t_creative_arts"], "columns_datatype": ["Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Calendar date", "Number"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {"precisionStyle": "