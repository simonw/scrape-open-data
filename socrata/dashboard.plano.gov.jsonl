{"resource": {"name": "TTHM & HAA5 Quarterly Rolling Averages Data.", "id": "pbib-2w2z", "resource_name": null, "parent_fxf": [], "description": "Total Trihalomethanes (TTHM) and Haloacetic Acids (HAA5) are disinfection byproducts that are monitored quarterly by the Texas Commission on Environmental Quality (TCEQ). The results in this data set are calculated quarterly averages by site using the results from each sample location. Sample data for each location is available on the TTHM and HAA5 pages.", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-10-27T10:31:17.000Z", "createdAt": "2019-07-18T17:19:12.000Z", "metadata_updated_at": "2024-10-27T10:31:17.000Z", "data_updated_at": "2024-10-27T10:31:17.000Z", "columns_name": ["Site Name", "Below MCL of 80 ug/L", "HAA5 Rolling Average", "TTHM Rolling Average", "Quarter Sampling Date", "Below MCL of 60 ug/L"], "columns_field_name": ["site_name", "below_mcl_of_80_ug_l", "haa5_rolling_average", "tthm_rolling_average", "quarter_sampling_date", "below_mcl_of_60_ug_l"], "columns_datatype": ["Text", "Number", "Number", "Number", "Calendar date", "Number"], "columns_description": ["Sample Site Location", "A 1 value indicates the rolling average at the location is below the TTHM MCL of 80 ug/L.", "Calculated rolling quarterly average for HAA5 (in ug/L) for the current and previous three sample dates.", "Calculated rolling quarterly average for TTHM (in ug/L) for the current and previous three sample dates.", "Date of samples last taken that is used in the calculated rolling quarterly average.", "A 1 value indicates the rolling average at the location is below the HAA5 MCL of 60 ug/L."], "columns_format": [{}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2019-07-18T17:22:19.000Z"}, "classification": {"categories": [], "ta