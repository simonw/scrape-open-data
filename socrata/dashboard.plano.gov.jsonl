{"resource": {"name": "Bacteria Sample Data", "id": "e49x-tw9b", "resource_name": null, "parent_fxf": [], "description": "Samples are taken daily at locations throughout the distribution system. Temperature, pH, and Total Chlorine Residual are collected by city personnel. Samples are taken to a lab to be analyzed for Total Coliform and E. Coli indicators. Results are returned to the city the following business day.", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2025-01-23T11:44:52.000Z", "createdAt": "2018-10-31T19:18:11.000Z", "metadata_updated_at": "2025-01-23T11:44:44.000Z", "data_updated_at": "2025-01-23T11:44:52.000Z", "columns_name": ["Street", "Replacement Address/Notes", "Number of Samples Taken", "Total Chlorine Residual", "RESULTS", "Free Chlorine", "DATE", "SITE #", "Sample Type"], "columns_field_name": ["street", "replacement_address_or_notes", "number_of_samples_taken", "total_chlorine_residual", "results", "free_chlorine", "date", "site", "replacement_sample"], "columns_datatype": ["Text", "Text", "Number", "Number", "Text", "Number", "Calendar date", "Text", "Text"], "columns_description": ["Street name for where water sample was collected.", "Indicates the location of replacement samples, special samples, or any notes associated with the sample.", "Number of samples taken at the location.", "The level of chlorine disinfectant by measuring chloramines (minimum requirement is .5 mg/L). Instruments have an accuracy of plus or minus 0.1 mg/L.", "Provides results from the laboratory to indicate pass, fail, or if sample was rejected.", "The amount of free chlorine as measured in mg/L. This number increases in Feb/Mar during the chlorine maintenance period. Instruments have an accuracy of plus or minus 0.1 mg/L.", "Date test was conducted.", "Unique identifier for the bacteria sample site.", "Bacteria Samples are routine and collected every 30 days. If a sample has an error, is rejected, or has bacteria present, a replacement sample is taken. This column indicates if the sample is a replacement. Special Samples are locations that are not normally sampled. Refer to the notes section to determine why sample was taken."], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2019-10-10T18:42:03.000Z"}, "classification": {"categories": [], "tags": [], "domain_category": "Public Works", "domain_tags": ["bacteria", "*s drive", "water quality"], "domain_metadata": []}, "metadata": {"domain": "dashboard.plano.gov"}, "permalink": "https://dashboard.plano.gov/d/e49x-tw9b", "link": "https://dashboard.plano.gov/Public-Works/Bacteria-Sample-Data/e49x-tw9b", "owner": {"id": "gxds-w39h", "user_type": "interactive", "display_name": "Rod"}, "creator": {"id": "gxds-w39h", "user_type": "interactive", "display_name": "Rod"}}
