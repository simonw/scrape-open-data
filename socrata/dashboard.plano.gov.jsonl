{"resource": {"name": "Parks and Recreation Attendance Data", "id": "n5tf-z5jy", "parent_fxf": [], "description": "This data set contains information on the Parks and Recreation attendance. The letters contained within parentheses in the top row denote more information about where the data comes from. From left to right, the parentheses stand for the following: (T) - Total, (AQ) - Aquatics Program, (ADATH) - Adult Athletics, (CAR) Carpenter Park Recreation Center, (LIB) - Liberty Recreation Center, (OAK) - Oak Point Center, (OUT) - Outdoor Program, (SEN) - Senior Center, (TR) - Therapeutic Recreation, (TOM) - The Tom Muehlenbeck Center", "attribution": "The City of Plano Department of Parks and Recreation", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-08-02T08:03:18.000Z", "createdAt": "2015-11-24T16:28:50.000Z", "metadata_updated_at": "2024-08-02T08:03:18.000Z", "data_updated_at": "2024-08-02T08:03:18.000Z", "columns_name": ["(T) Aquatics PAC/NAT", "(T) Program Attendance", "(T) Center Attendance", "(T) Tom Muehlenbeck", "(T) Senior Center", "(T) Liberty", "(T) Arts & Events", "(T) Aerobats", "(T) Adapted Recreation", "(T) Tennis", "Date", "(T) Nature Retreat Center", "(T) Oak Point", "(T) Golf", "(T) Aquatics Jack Carter", "(T) Carpenter", "(T) Adult Athletics"], "columns_field_name": ["t_aquatics", "_t_program_attendance", "t_center_attendance", "t_tom_muehlenbeck", "t_senior_center", "t_liberty", "t_creative_arts", "t_aerobats", "t_therapeutic_rec", "t_tennis", "date", "t_outdoor", "t_oak_point", "t_golf", "_t_aquatics_jack_carter", "t_carpenter", "t_adult_athletics"], "columns_datatype": ["Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Calendar date", "Number", "Number", "Number", "Number", "Number", "Number"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {"precisionStyl