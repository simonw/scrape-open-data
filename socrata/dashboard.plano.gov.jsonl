{"resource": {"name": "Parks and Recreation Attendance Data", "id": "n5tf-z5jy", "resource_name": null, "parent_fxf": [], "description": "This data set contains information on the Parks and Recreation attendance. The letters contained within parentheses in the top row denote more information about where the data comes from. From left to right, the parentheses stand for the following: (T) - Total, (AQ) - Aquatics Program, (ADATH) - Adult Athletics, (CAR) Carpenter Park Recreation Center, (LIB) - Liberty Recreation Center, (OAK) - Oak Point Center, (OUT) - Outdoor Program, (SEN) - Senior Center, (TR) - Therapeutic Recreation, (TOM) - The Tom Muehlenbeck Center", "attribution": "The City of Plano Department of Parks and Recreation", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-09-18T08:00:43.000Z", "createdAt": "2015-11-24T16:28:50.000Z", "metadata_updated_at": "2024-09-18T08:00:42.000Z", "data_updated_at": "2024-09-18T08:00:43.000Z", "columns_name": ["(T) Aerobats", "(T) Adapted Recreation", "Date", "(T) Tom Muehlenbeck", "(T) Carpenter", "(T) Center Attendance", "(T) Liberty", "(T) Arts & Events", "(T) Tennis", "(T) Adult Athletics", "(T) Aquatics Jack Carter", "(T) Program Attendance", "(T) Senior Center", "(T) Nature Retreat Center", "(T) Oak Point", "(T) Golf", "(T) Aquatics PAC/NAT"], "columns_field_name": ["t_aerobats", "t_therapeutic_rec", "date", "t_tom_muehlenbeck", "t_carpenter", "t_center_attendance", "t_liberty", "t_creative_arts", "t_tennis", "t_adult_athletics", "_t_aquatics_jack_carter", "_t_program_attendance", "t_senior_center", "t_outdoor", "t_oak_point", "t_golf", "t_aquatics"], "columns_datatype": ["Number", "Number", "Calendar date", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {"precisionStyle": "