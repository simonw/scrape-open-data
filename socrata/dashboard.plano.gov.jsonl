{"resource": {"name": "Parks and Recreation Attendance Data", "id": "n5tf-z5jy", "resource_name": null, "parent_fxf": [], "description": "This data set contains information on the Parks and Recreation attendance. The letters contained within parentheses in the top row denote more information about where the data comes from. From left to right, the parentheses stand for the following: (T) - Total, (AQ) - Aquatics Program, (ADATH) - Adult Athletics, (CAR) Carpenter Park Recreation Center, (LIB) - Liberty Recreation Center, (OAK) - Oak Point Center, (OUT) - Outdoor Program, (SEN) - Senior Center, (TR) - Therapeutic Recreation, (TOM) - The Tom Muehlenbeck Center", "attribution": "The City of Plano Department of Parks and Recreation", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2025-01-13T09:15:07.000Z", "createdAt": "2015-11-24T16:28:50.000Z", "metadata_updated_at": "2025-01-13T09:15:06.000Z", "data_updated_at": "2025-01-13T09:15:07.000Z", "columns_name": ["(T) Aquatics PAC/NAT", "(T) Nature Retreat Center", "Date", "(T) Tom Muehlenbeck", "(T) Program Attendance", "(T) Center Attendance", "(T) Golf", "(T) Liberty", "(T) Adapted Recreation", "(T) Adult Athletics", "(T) Tennis", "(T) Arts & Events", "(T) Oak Point", "(T) Aquatics Jack Carter", "(T) Senior Center", "(T) Carpenter", "(T) Aerobats"], "columns_field_name": ["t_aquatics", "t_outdoor", "date", "t_tom_muehlenbeck", "_t_program_attendance", "t_center_attendance", "t_golf", "t_liberty", "t_therapeutic_rec", "t_adult_athletics", "t_tennis", "t_creative_arts", "t_oak_point", "_t_aquatics_jack_carter", "t_senior_center", "t_carpenter", "t_aerobats"], "columns_datatype": ["Number", "Number", "Calendar date", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {"view": "date_m