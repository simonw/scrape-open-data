{"resource": {"name": "Parks and Recreation Attendance Data", "id": "n5tf-z5jy", "resource_name": null, "parent_fxf": [], "description": "This data set contains information on the Parks and Recreation attendance. The letters contained within parentheses in the top row denote more information about where the data comes from. From left to right, the parentheses stand for the following: (T) - Total, (AQ) - Aquatics Program, (ADATH) - Adult Athletics, (CAR) Carpenter Park Recreation Center, (LIB) - Liberty Recreation Center, (OAK) - Oak Point Center, (OUT) - Outdoor Program, (SEN) - Senior Center, (TR) - Therapeutic Recreation, (TOM) - The Tom Muehlenbeck Center", "attribution": "The City of Plano Department of Parks and Recreation", "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2024-09-19T08:00:36.000Z", "createdAt": "2015-11-24T16:28:50.000Z", "metadata_updated_at": "2024-09-19T08:00:36.000Z", "data_updated_at": "2024-09-19T08:00:36.000Z", "columns_name": ["(T) Liberty", "(T) Center Attendance", "(T) Adapted Recreation", "(T) Aerobats", "(T) Carpenter", "(T) Tom Muehlenbeck", "(T) Arts & Events", "(T) Tennis", "Date", "(T) Adult Athletics", "(T) Aquatics PAC/NAT", "(T) Golf", "(T) Oak Point", "(T) Nature Retreat Center", "(T) Senior Center", "(T) Program Attendance", "(T) Aquatics Jack Carter"], "columns_field_name": ["t_liberty", "t_center_attendance", "t_therapeutic_rec", "t_aerobats", "t_carpenter", "t_tom_muehlenbeck", "t_creative_arts", "t_tennis", "date", "t_adult_athletics", "t_aquatics", "t_golf", "t_oak_point", "t_outdoor", "t_senior_center", "_t_program_attendance", "_t_aquatics_jack_carter"], "columns_datatype": ["Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Calendar date", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {"precisionStyle