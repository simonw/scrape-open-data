{"resource": {"name": "2020 Census Tracts", "id": "s8ea-j8r7", "parent_fxf": [], "description": "2020 Census Tract polygons for all of Pierce County, realigned to Pierce County roads, parcels, hydro, railroads, powerlines, etc. Population figures for race, ethnicity, median age, household size, household count, etc were downloaded from the US Census website and joined to this layer. Please read metadata for additional information (https://matterhorn.co.pierce.wa.us/GISmetadata/pdbis_census2020_tracts.html). Any data download constitutes acceptance of the Terms of Use (https://matterhorn.co.pierce.wa.us/Disclaimer/PierceCountyGISDataTermsofUse.pdf).", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-02-23T22:14:57.000Z", "createdAt": "2022-02-23T22:14:51.000Z", "metadata_updated_at": "2022-02-23T22:14:53.000Z", "data_updated_at": "2022-02-23T22:14:57.000Z", "columns_name": ["GEOID20", "Shape__Length", "Shape__Area", "HousingVacant", "HousingOccupied", "RaceAfricanAmerican", "NAME20", "COUNTYFP20", "STATEFP20", "TRACTCE20", "RaceMixed", "RaceOther", "RacePacificIslander", "RaceAsian", "RaceNativeAmerican", "RaceWhite", "PopulationTotal", "OBJECTID", "NAMELSAD20", "HousingCount", "the_geom"], "columns_field_name": ["geoid20", "shape_length", "shape_area", "housingvacant", "housingoccupied", "raceafricanamerican", "name20", "countyfp20", "statefp20", "tractce20", "racemixed", "raceother", "racepacificislander", "raceasian", "racenativeamerican", "racewhite", "populationtotal", "objectid", "namelsad20", "housingcount", "the_geom"], "columns_datatype": ["Text", "Number", "Number", "Number", "Number", "Number", "Text", "Text", "Text", "Text", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Number", "Text", "Number", "MultiPolygon"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}