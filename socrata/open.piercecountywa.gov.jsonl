{"resource": {"name": "Crime Data (Past 12 Months)", "id": "st9d-gc37", "parent_fxf": [], "description": "<DIV STYLE=\"text-align:Left;font-size:12pt\"><DIV><P><SPAN>This data shows approximate location of select offenses within unincorporated Pierce County, and the cities of Bonney Lake, Eatonville, Edgewood, Gig Harbor, Puyallup, South Prairie, and University Place. The data is for the previous 12 months and is updated monthly.  Please see full metadata (https://matterhorn.co.pierce.wa.us/GISmetadata/pdbsd_crime_data.html) for additional information.   Any data download constitutes acceptance of the Terms of Use (https://matterhorn.co.pierce.wa.us/Disclaimer/PierceCountyGISDataTermsofUse.pdf).</SPAN></P></DIV></DIV>", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-09-14T00:49:20.000Z", "createdAt": "2022-09-14T00:49:09.000Z", "metadata_updated_at": "2022-09-14T00:49:11.000Z", "data_updated_at": "2022-09-14T00:49:20.000Z", "columns_name": ["City", "YCoord", "XCoord", "LocCode", "OccurredOn", "District", "CaseNo", "OBJECTID", "the_geom", "Public_Nam", "NAT_Name"], "columns_field_name": ["city", "ycoord", "xcoord", "loccode", "occurredon", "district", "caseno", "objectid", "the_geom", "public_nam", "nat_name"], "columns_datatype": ["Text", "Number", "Number", "Text", "Date", "Text", "Text", "Number", "Point", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-09-14T00:49:11.000Z"}, "classification": {"categories": [], "tags": [], "domain_tags": [], "domain_metadata": []}, "metadata": {"domain": "open.piercecountywa.gov"}, "permalink": "https://open.piercecountywa.gov/d/st9d-gc37", "link": "https://open.piercecountywa.gov/dataset/Crime-Data-Past-12-