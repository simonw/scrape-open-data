{"resource": {"name": "Encumbrances/Easements - polygons", "id": "nxhy-v4w3", "parent_fxf": [], "description": "This polygon theme identifies all the different easements in Pierce County and also specifies the type of easement (drainage, utility, sewer etc.) The term \"Encumbrance\" allows for other types of rights and interest to be added in the future. Encumbrances and easements are limitations on the use of the property or land. Please read metadata (https://matterhorn.co.pierce.wa.us/GISmetadata/pdbparc_encumbrance.html) for additional information. Any data download constitutes acceptance of the Terms of Use. (https://matterhorn.co.pierce.wa.us/Disclaimer/PierceCountyGISDataTermsofUse.pdf)", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-07-23T00:13:48.000Z", "createdAt": "2022-07-23T00:12:56.000Z", "metadata_updated_at": "2022-07-23T00:12:58.000Z", "data_updated_at": "2022-07-23T00:13:48.000Z", "columns_name": ["ReferenceNumber", "EncumbranceSymbol", "Shape__Length", "Shape__Area", "EditDate", "EncumbranceComment", "ExpirationDate", "EffectiveDate", "the_geom", "EncumbranceDescription", "EncumbranceType", "OBJECTID", "EncumbranceOwner", "EncumbranceOrigin"], "columns_field_name": ["referencenumber", "encumbrancesymbol", "shape_length", "shape_area", "editdate", "encumbrancecomment", "expirationdate", "effectivedate", "the_geom", "encumbrancedescription", "encumbrancetype", "objectid", "encumbranceowner", "encumbranceorigin"], "columns_datatype": ["Text", "Number", "Number", "Number", "Date", "Text", "Date", "Date", "MultiPolygon", "Text", "Text", "Number", "Text", "Text"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-07-23T00:12: