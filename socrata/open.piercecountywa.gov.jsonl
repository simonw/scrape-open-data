{"resource": {"name": "Transportation Improvement Program TIP (pts)", "id": "ybx9-6my6", "parent_fxf": [], "description": "Approximate point locations for planned projects on new and existing facilities in the comprehensive transportation project.  Projects are for unincorporated Pierce County for the ensuing six calendar years.  Please read metadata for additional information (https://matterhorn.co.pierce.wa.us/GISmetadata/pdbtrans_trans_improvement_program_pts.html). Any data download constitutes acceptance of the Terms of Use (https://matterhorn.co.pierce.wa.us/Disclaimer/PierceCountyGISDataTermsofUse.pdf).", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2023-05-09T15:07:56.000Z", "createdAt": "2023-05-09T15:07:52.000Z", "metadata_updated_at": "2023-05-09T15:07:54.000Z", "data_updated_at": "2023-05-09T15:07:56.000Z", "columns_name": ["MIN_X", "MIN_Y", "MAX_X", "MAX_Y", "MAP_ID", "CRP", "LENGTH", "ELEMENTS", "TOTAL_COST", "CLASS", "PRIORITY_G", "PROJECT_LI", "PROJECT_NA", "PROJECT_SC", "CON_SCHEDU", "ROW_SCHEDU", "FE_SCHEDUL", "PE_SCHEDUL", "TYPE", "the_geom", "OBJECTID"], "columns_field_name": ["min_x", "min_y", "max_x", "max_y", "map_id", "crp", "length", "elements", "total_cost", "class", "priority_g", "project_li", "project_na", "project_sc", "con_schedu", "row_schedu", "fe_schedul", "pe_schedul", "type", "the_geom", "objectid"], "columns_datatype": ["Number", "Number", "Number", "Number", "Number", "Number", "Number", "Text", "Number", "Text", "Text", "Text", "Text", "Text", "Text", "Text", "Text", "Text", "Text", "Point", "Number"], "columns_description": ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "locked": false, "blob_mime_type": null, "hide_from_data_json": false, "public