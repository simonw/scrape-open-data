{"resource": {"name": "Drainage - Virtual Drainlines", "id": "vudv-p5ex", "parent_fxf": [], "description": "Virtual Drainlines are used to maintain network connectivity when conveyance features are absent. For example, if a stormwater pond has both inlet and outlet conveyance pipes, a virtual drainline is used to connect the inlet and outlet pipes through the pond. Virtual drainlines do not represent \"real-world\" features, but are used to show the flow direction and path of stormwater and maintain network connectivity in a GIS.\n\nPlease read metadata (https://matterhorn.co.pierce.wa.us/GISmetadata/pdbpubw_swVirtualDrainLine.html) for additional information.  Any data download constitutes acceptance of the Terms of Use (https://matterhorn.co.pierce.wa.us/Disclaimer/PierceCountyGISDataTermsofUse.pdf).", "attribution": null, "attribution_link": null, "contact_email": null, "type": "dataset", "updatedAt": "2022-07-25T23:25:37.000Z", "createdAt": "2022-07-25T23:25:34.000Z", "metadata_updated_at": "2022-07-25T23:25:35.000Z", "data_updated_at": "2022-07-25T23:25:37.000Z", "columns_name": ["Enabled", "Comment", "the_geom", "Shape__Length", "Description", "OBJECTID", "EditedOn"], "columns_field_name": ["enabled", "comment", "the_geom", "shape_length", "description", "objectid", "editedon"], "columns_datatype": ["Number", "Text", "MultiLine", "Number", "Text", "Number", "Date"], "columns_description": ["", "", "", "", "", "", ""], "columns_format": [{}, {}, {}, {}, {}, {}, {}], "provenance": "official", "lens_view_type": "tabular", "lens_display_type": "table", "blob_mime_type": null, "hide_from_data_json": false, "publication_date": "2022-07-25T23:25:35.000Z"}, "classification": {"categories": [], "tags": [], "domain_tags": [], "domain_metadata": []}, "metadata": {"domain": "open.piercecountywa.gov"}, "permalink": "https://open.piercecountywa.gov/d/vudv-p5ex", "link": "https://open.piercecountywa.gov/dataset/Drainage-Virtual-Drainlines/vudv-p5ex", "owner": {"id": "b87i-ki